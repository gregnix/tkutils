} -result {1 1 1 1}

test gui-12.3 {kein Schloss-Sinnbild in der Statuszeile} -constraints {tk tbl} -body {
    # "\u1F512" liegt jenseits der BMP und braucht "\U0001F512" --
    # und selbst dann muss die Schrift es haben. Gemessen kam ein
    # Ersatzzeichen heraus. Worte sind eindeutig.
    frischGui
    ::ab::statusMelden "x"
    # Nur Zeichen unterhalb U+0100.
    set hoch 0
    foreach c [split $::ab::status ""] {
        if {[scan $c %c n] && $n > 255} { incr hoch }
    }
    set hoch
} -result 0

test gui-13.1 {verschiedene Eingaben werden abgelehnt} -constraints {tk tbl} -body {
    # Ein Tippfehler im Kennwort einer Datei, die danach nur damit zu
    # oeffnen ist, laesst sich nicht mehr berichtigen.
    frischGui
    adressbuch::schreiben "" {vorname A name B}
    array set ::ab::vs {neu eins neu2 zwei}
    set r [::ab::verschluesselnAusfuehren]
    list $r [string match "*verschieden*" $::ab::status] \
         [adressbuch::istVerschluesselt]
} -result {0 1 0}

# --- Start mit verschluesselter Datei ---------------------------------------
#
# Ohne diesen Weg starb die Anwendung mit einem Tcl-Stapelabzug, BEVOR
# es ein Fenster gab -- gemeldet 12.09.2026. Wer sein Adressbuch
# verschluesselt hatte, kam nicht mehr hinein.

proc mitKennwort {antworten skript} {
    # fragen MUSS 1 sein -- sonst bricht oeffnenMitKennwort gleich ab
    # und fragt nie. Ein frueherer Test hatte es auf 0 gelassen, und
    # der Fall galt als "nicht geoeffnet", obwohl das Kennwort stimmte.
    set altFragen $::ab::fragen
    set ::ab::fragen 1
    # Und tk_messageBox stumm schalten -- am Ende der drei Versuche
    # wartete sonst ein Dialog auf eine Antwort, die niemand gibt.
    rename ::tk_messageBox ::_echterDialog2
    proc ::tk_messageBox {args} { return ok }
    rename ::ab::kennwortFragen ::ab::_echtKennwortFragen
    set ::testAntworten $antworten
    proc ::ab::kennwortFragen {datei versuch} {
        set a [lindex $::testAntworten [expr {$versuch - 1}]]
        if {$a eq ""} { return "\u0000ABBRUCH" }
        return $a
    }
    set rc [catch {uplevel 1 $skript} e opts]
    rename ::ab::kennwortFragen {}
    rename ::ab::_echtKennwortFragen ::ab::kennwortFragen
    rename ::tk_messageBox {}
    rename ::_echterDialog2 ::tk_messageBox
    set ::ab::fragen $altFragen
    if {$rc} { return -options $opts $e }
    return $e
}

test gui-14.1 {verschluesselte Datei: es wird nach dem Kennwort gefragt} \
        -constraints {tk tbl krypto} -body {
    set f [makeFile {} start1.db]
    verschluesselteDatei $f geheim {vorname A name Bergfeld}
    set r [mitKennwort {geheim} {::ab::oeffnenMitKennwort $f}]
    set n [expr {$r ? [dict get [adressbuch::lesen 1] name] : ""}]
    adressbuch::schliessen
    list $r $n
} -result {1 Bergfeld}

test gui-14.2 {dreimal falsch -- dann wird nicht geoeffnet} \
        -constraints {tk tbl krypto} -body {
    set f [makeFile {} start2.db]
    verschluesselteDatei $f geheim {vorname A name B}
    set r [mitKennwort {falsch1 falsch2 falsch3} {::ab::oeffnenMitKennwort $f}]
    adressbuch::schliessen
    set r
} -result 0

test gui-14.3 {Abbrechen oeffnet nicht} -constraints {tk tbl krypto} -body {
    set f [makeFile {} start3.db]
    verschluesselteDatei $f geheim {vorname A name B}
    # Leere Antwort = Abbruch
    set r [mitKennwort {{}} {::ab::oeffnenMitKennwort $f}]
    adressbuch::schliessen
    set r
} -result 0

test gui-14.4 {eine offene Datei wird ohne Frage geoeffnet} -constraints {tk tbl} -body {
    # Wuerde gefragt, bliebe der Test haengen.
    set f [makeFile {} start4.db]
    file delete $f
    adressbuch::schliessen
    adressbuch::oeffnen $f
    adressbuch::schreiben "" {vorname A name Bergfeld}
    adressbuch::schliessen
    set r [::ab::oeffnenMitKennwort $f]
    set n [dict get [adressbuch::lesen 1] name]
    adressbuch::schliessen
    list $r $n
} -result {1 Bergfeld}

test gui-15.1 {Verschluesseln, Kennwort aendern, aufheben -- alle drei Wege} \
        -constraints {tk tbl krypto kryptoEin} -body {
    frischGui
    adressbuch::csvLesen [file join [file dirname [file normalize [info script]]] \
            beispiel.csv]
    ::ab::listeFuellen
    set schritte {}
    array set ::ab::vs {neu geheim neu2 geheim}
    ::ab::verschluesselnAusfuehren
    lappend schritte [adressbuch::istVerschluesselt]
    array set ::ab::vs {neu zweites neu2 zweites}
    ::ab::verschluesselnAusfuehren
    lappend schritte [adressbuch::istVerschluesselt]
    ::ab::entschluesseln
    lappend schritte [adressbuch::istVerschluesselt]
    # Und die Daten sind noch da.
    lappend schritte [llength [adressbuch::alle]]
    set schritte
} -result {1 1 0 7}

test gui-15.2 {aufheben bei offener Datei tut nichts} -constraints {tk tbl} -body {
    # Und meldet es, statt stillschweigend umzuschreiben.
    frischGui
    adressbuch::schreiben "" {vorname A name B}
    set r [::ab::entschluesseln]
    list $r [string match "*nicht verschluesselt*" $::ab::status]
} -result {0 1}

test gui-16.1 {der Ordner-Aufruf stuerzt ohne Dateiverwalter nicht ab} \
        -constraints {tk tbl} -body {
    # Wer kein xdg-open hat, bekommt den Pfad genannt -- kein Fehler.
    frischGui
    adressbuch::schreiben "" {vorname A name B}
    set r [::ab::ordnerOeffnen]
    # 0 oder 1, aber kein Absturz -- und die Statuszeile nennt den Ordner.
    list [expr {$r in {0 1}}] \
         [string match "*[file dirname [adressbuch::dateiName]]*" $::ab::status]
} -result {1 1}

test gui-16.2 {ohne Datei wird es gemeldet} -constraints {tk tbl} -body {
    frischGui
    adressbuch::schliessen
    set r [::ab::ordnerOeffnen]
    list $r [string match "*Keine Datei*" $::ab::status]
} -result {0 1}

aufraeumenSicherungen
# --- Verschluesseln abgeschaltet: was die Oberflaeche zeigt -----------------

proc dateiMenueEintraege {} {
    set out {}
    set d .menu.datei
    if {![winfo exists $d]} { set d [lindex [lsearch -all -inline [winfo children .] *menu*] 0].datei }
    for {set i 0} {$i <= [$d index end]} {incr i} {
        if {[$d type $i] eq "command"} { lappend out [$d entrycget $i -label] }
    }
    return $out
}

test gui-16.1 {abgeschaltet: nur "aufheben" steht im Menue} \
        -constraints {tk tbl kryptoAus} -body {
    frischGui
    set m [dateiMenueEintraege]
    list [expr {"Verschluesselung aufheben..." in $m}] \
         [expr {"Verschluesseln / Kennwort aendern..." in $m}] \
         [expr {"Verschluesselung einrichten..." in $m}]
} -result {1 0 0}

test gui-16.2 {abgeschaltet: der Dialog verschluesselt nicht und sagt warum} \
        -constraints {tk tbl kryptoAus} -body {
    frischGui
    adressbuch::schreiben "" {vorname A name B}
    set r [::ab::verschluesselnDialog]
    list $r [adressbuch::istVerschluesselt]
} -result {0 0}

test gui-16.3 {abgeschaltet: Hilfe -> Ueber sagt es} -constraints {tk tbl kryptoAus} -body {
    frischGui
    string match "*Verschluesseln: ABGESCHALTET*" [::ab::ueberText]
} -result 1

::tcltest::cleanupTests
