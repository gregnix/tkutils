package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
testConstraint tk [expr {![catch {package require Tk}]}]
testConstraint tbl [expr {![catch {package require tablelist_tile}]}]

if {[testConstraint tk] && [testConstraint tbl]} {
    set ::argv0 __gui_test__
    set ::argv {}
    source [file join $here adressbuch.tcl]
    catch {wm withdraw .}
}

# ERST NACH dem Laden des Modells -- vorher gibt es
# kannVerschluesseln nicht, und die Bedingung waere immer 0.
testConstraint krypto [expr {
    [llength [info procs ::adressbuch::kannVerschluesseln]]
    && [adressbuch::kannVerschluesseln]}]

# Die Sicherungen der Tests wieder wegraeumen.
#
# Sonst bleibt nach jedem Lauf eine ".sicherung" im Verzeichnis liegen --
# dieselbe Unsitte, die bei den pdf4tcl-Demos dreizehn Dateien in den
# Baum gespuelt hat.
proc aufraeumenSicherungen {} {
    foreach f [glob -nocomplain -directory [::tcltest::configure -tmpdir] \
            *.sicherung *.vor-verschluesselung] {
        file delete -force $f
    }
    foreach f [glob -nocomplain -directory \
            [file dirname [file normalize [info script]]] *.sicherung *.vor-verschluesselung] {
        file delete -force $f
    }
}

proc frischGui {} {
    adressbuch::schliessen
    set f [makeFile {} gui-test.db]
    file delete $f
    adressbuch::oeffnen $f
    foreach w [winfo children .] { destroy $w }
    catch {destroy .menu}
    ::ab::bauen
    wm withdraw .
    # Keine Rueckfragen im Test -- ein tk_messageBox wartet sonst auf
    # eine Antwort, die niemand gibt, und der Lauf haengt.
    set ::ab::fragen 0
    set ::ab::aktuell ""
    set ::ab::suche ""
    ::ab::listeFuellen
    update
}

test gui-1.1 {die Auswahl fuellt die Maske} -constraints {tk tbl} -body {
    frischGui
    adressbuch::schreiben "" {vorname Anna name Bergfeld ort Ortoben}
    ::ab::listeFuellen
    $::ab::tbl selection set 0
    ::ab::zeileGewaehlt
    update
    [dict get $::ab::felder ort] get
} -result Ortoben

test gui-2.1 {die Kennung haengt nicht an der Zeilennummer} -constraints {tk tbl} -body {
    # DER FEHLER, DEN MAN EINMAL MACHT: nach dem Sortieren zeigt dieselbe
    # Zeilennummer auf einen anderen Datensatz. Wer sich die Nummer
    # merkt, bearbeitet den falschen.
    # serie-liste-maske/02-id-statt-zeile
    frischGui
    set idA [adressbuch::schreiben "" {vorname Anna name Zabel ort X}]
    set idB [adressbuch::schreiben "" {vorname Bernd name Adam ort Y}]
    ::ab::listeFuellen
    # Nach Name sortiert steht Adam vorn, obwohl Zabel zuerst angelegt wurde.
    set kennung0 [$::ab::tbl rowcget 0 -name]
    list [expr {$kennung0 == $idB}] [expr {$kennung0 != 0}]
} -result {1 1}

test gui-2.2 {die Auswahl folgt der Kennung, nicht der Zeile} -constraints {tk tbl} -body {
    # serie-liste-maske/06-auswahl-behalten
    frischGui
    set idA [adressbuch::schreiben "" {vorname Anna name Zabel ort Ortoben}]
    adressbuch::schreiben "" {vorname Bernd name Adam ort Ortunten}
    ::ab::listeFuellen $idA
    set vorher [::ab::aktuelleId]
    # Ein dritter Eintrag verschiebt die Zeilen.
    adressbuch::schreiben "" {vorname Clara name Bach ort Ortdrei}
    ::ab::listeFuellen
    list [expr {$vorher == $idA}] [expr {[::ab::aktuelleId] == $idA}]
} -result {1 1}

