test gui-6.1 {Loeschen springt auf den naechsten, nicht ins Leere} \
        -constraints {tk tbl} -body {
    # serie-liste-maske/07-neu-und-loeschen
    frischGui
    adressbuch::schreiben "" {vorname Anna name Adam ort X}
    set idB [adressbuch::schreiben "" {vorname Bernd name Bach ort Y}]
    ::ab::listeFuellen
    $::ab::tbl selection set 0
    ::ab::zeileGewaehlt
    # Ohne Rueckfrage loeschen: das Modell direkt, dann auffrischen wie
    # die Oberflaeche es tut.
    set naechste [$::ab::tbl rowcget 1 -name]
    adressbuch::loeschen [::ab::aktuelleId]
    set ::ab::aktuell ""
    ::ab::listeFuellen $naechste
    list [$::ab::tbl size] [expr {[::ab::aktuelleId] == $idB}]
} -result {1 1}

# --- die Rueckfrage bei ungespeicherten Aenderungen -------------------------
#
# Das ist die kniffligste Stelle der Anwendung: drei Antworten, drei
# Verhalten, und ein Dialog dazwischen. Genau hier ist die Versuchung
# gross, den Test bequemer einzurichten als die Wirklichkeit -- etwa
# indem man mit "fragen 0" prueft und damit den ganzen Zweig ueberspringt.
#
# Stattdessen wird tk_messageBox VORUEBERGEHEND ERSETZT. Geprueft wird
# derselbe Code, den der Benutzer ausloest.

# Verschluesseln ist im Modell abgeschaltet (::adressbuch::kryptoEin 0,
# Stand 2026-09-19). Tests, die ueber die Oberflaeche verschluesseln, laufen
# nur, wenn die Zeile im Code auf 1 steht. Das OEFFNEN einer schon
# verschluesselten Datei muss immer gehen und wird immer geprueft.
testConstraint kryptoEin [adressbuch::kryptoEin]
testConstraint kryptoAus [expr {![adressbuch::kryptoEin]}]

# verschluesselteDatei pfad kennwort satz -- Ausgangsmaterial: eine
# verschluesselte Datei. Die Funktion wird NUR dafuer eingeschaltet und
# danach, auch nach einem Fehler, auf den Stand im Code zurueckgesetzt.
proc verschluesselteDatei {f kennwort satz} {
    set vorher $::adressbuch::kryptoEin
    set ::adressbuch::kryptoEin 1
    try {
        file delete $f
        adressbuch::schliessen
        adressbuch::oeffnen $f
        adressbuch::schreiben "" $satz
        adressbuch::verschluesseln $kennwort
        adressbuch::schliessen
    } finally {
        set ::adressbuch::kryptoEin $vorher
    }
}

proc mitAntwort {antwort skript} {
    rename ::tk_messageBox ::_echterDialog
    proc ::tk_messageBox {args} [list return $antwort]
    set rc [catch {uplevel 1 $skript} e opts]
    rename ::tk_messageBox {}
    rename ::_echterDialog ::tk_messageBox
    if {$rc} { return -options $opts $e }
    return $e
}

test gui-7.1 {ohne Aenderung wird nicht gefragt} -constraints {tk tbl} -body {
    frischGui
    set id [adressbuch::schreiben "" {vorname Anna name Bergfeld ort Ortoben}]
    ::ab::listeFuellen $id
    set ::ab::fragen 1
    # Wuerde gefragt, bliebe der Test haengen -- es wird nicht gefragt.
    set r [::ab::wechselErlaubt]
    set ::ab::fragen 0
    set r
} -result 1

test gui-7.2 {"Speichern" schreibt und laesst wechseln} -constraints {tk tbl} -body {
    frischGui
    set id [adressbuch::schreiben "" {vorname Anna name Bergfeld ort Ortoben}]
    ::ab::listeFuellen $id
    set ::ab::fragen 1
    [dict get $::ab::felder ort] delete 0 end
    [dict get $::ab::felder ort] insert 0 Ortunten
    set r [mitAntwort yes {::ab::wechselErlaubt}]
    set ::ab::fragen 0
    list $r [dict get [adressbuch::lesen $id] ort]
} -result {1 Ortunten}

test gui-7.3 {"Nein" wechselt und verwirft} -constraints {tk tbl} -body {
    frischGui
    set id [adressbuch::schreiben "" {vorname Anna name Bergfeld ort Ortoben}]
    ::ab::listeFuellen $id
    set ::ab::fragen 1
    [dict get $::ab::felder ort] delete 0 end
    [dict get $::ab::felder ort] insert 0 Ortunten
    set r [mitAntwort no {::ab::wechselErlaubt}]
    set ::ab::fragen 0
    # Gewechselt werden darf, aber geschrieben wurde NICHT.
    list $r [dict get [adressbuch::lesen $id] ort]
} -result {1 Ortoben}

test gui-7.4 {"Abbrechen" verhindert den Wechsel} -constraints {tk tbl} -body {
    frischGui
    set id [adressbuch::schreiben "" {vorname Anna name Bergfeld ort Ortoben}]
    ::ab::listeFuellen $id
    set ::ab::fragen 1
    [dict get $::ab::felder ort] delete 0 end
    [dict get $::ab::felder ort] insert 0 Ortunten
    set r [mitAntwort cancel {::ab::wechselErlaubt}]
    set ::ab::fragen 0
    # Nicht gewechselt, nicht geschrieben, und die Aenderung steht noch da.
    list $r [dict get [adressbuch::lesen $id] ort] \
         [[dict get $::ab::felder ort] get]
} -result {0 Ortoben Ortunten}

test gui-7.5 {ein Pflichtfeld verhindert den Wechsel trotz "Speichern"} \
        -constraints {tk tbl} -body {
    # Wer "Speichern" waehlt und das Pflichtfeld leer laesst, darf NICHT
    # wechseln -- sonst ist die Aenderung weg, obwohl er sie sichern
    # wollte.
    frischGui
    set id [adressbuch::schreiben "" {vorname Anna name Bergfeld ort Ortoben}]
    ::ab::listeFuellen $id
    set ::ab::fragen 1
    [dict get $::ab::felder name] delete 0 end
    set r [mitAntwort yes {::ab::wechselErlaubt}]
    set ::ab::fragen 0
    list $r [dict get [adressbuch::lesen $id] name]
} -result {0 Bergfeld}

# --- der echte Mausklick ---------------------------------------------------
#
# DIE BINDUNG MUSS AM WIDGET HAENGEN, NICHT AM KORPUS.
#
# "bind [$tbl bodytag] <<TablelistSelect>>" sieht richtig aus und war es
# nicht: bei einem echten Mausklick blieb die Maske LEER, obwohl die
# Zeile ausgewaehlt war. Gemeldet 12.09.2026 mit einem Bildschirmfoto.
#
# Warum kein Test es fing: ein von Hand erzeugtes
# "event generate <<TablelistSelect>>" laeuft NACH dem Setzen der
# Auswahl und geht auch dann gut, wenn die Bindung falsch sitzt.
#
# WARUM HIER NUR DIE BINDUNG GEPRUEFT WIRD und nicht der Klick:
# ein erzeugter <Button-1> kommt unter Xvfb ohne Fenstermanager nicht
# zuverlaessig an -- gemessen, mal ja, mal nein, auch im frischen
# Prozess. Ein Test, der mal gruen und mal rot ist, misst nichts.
# Geprueft wird deshalb, WORAN die Bindung haengt. Das ist schwaecher
# als der Klick, aber es ist ehrlich, und es faengt den Rueckfall.
test gui-8.1 {die Auswahlbindung haengt am Widget, nicht am Korpus} \
        -constraints {tk tbl} -body {
    frischGui
    set t $::ab::tbl
    set amWidget [expr {[string match *zeileGewaehlt* \
            [bind $t <<TablelistSelect>>]]}]
    set amKorpus [expr {[string match *zeileGewaehlt* \
            [bind [$t bodytag] <<TablelistSelect>>]]}]
    list $amWidget $amKorpus
} -result {1 0}

test gui-9.1 {die Bildlaufleiste ist ein Nachbar der Tabelle, kein Kind} \
        -constraints {tk tbl} -body {
    # Erste Fassung: "ttk::scrollbar $pfad.sb", wo $pfad die Tabelle
    # war. Damit lag sie IN ihr, zwischen .hdr, .body und .lb -- sichtbar
    # als winziger Stummel unten rechts. Gemeldet 12.09.2026.
    #
    # Ein Widget unter dem Pfad eines Megawidgets gehoert diesem; es
    # verwaltet den Platz darin selbst und weiss von dem Fremdling
    # nichts.
    frischGui
    set t $::ab::tbl
    set sb [winfo parent $t].sb
    # Die falsche Fassung faellt nicht nur auf, sie HAENGT: zwei
    # Geometrieverwalter um denselben Platz kommen nicht zur Ruhe, und
    # der Lauf lief in die Zeitsperre. Dieser Test faengt sie vorher.
    list [expr {[winfo parent $sb] eq [winfo parent $t]}] \
         [expr {[winfo parent $sb] ne $t}]
} -result {1 1}

test gui-9.2 {die Leiste nimmt die volle Hoehe der Tabelle ein} \
        -constraints {tk tbl} -body {
    # Die Verwandtschaft allein genuegt nicht -- sie muss auch den
    # Platz bekommen. Ein "pack -side right" ohne -fill y gaebe wieder
    # einen Stummel.
    frischGui
    wm deiconify .
    update ; after 300 ; update
    adressbuch::csvLesen [file join [file dirname [file normalize [info script]]] \
            beispiel.csv]
    ::ab::listeFuellen
    update ; after 200 ; update
    set t $::ab::tbl
    set sb [winfo parent $t].sb
    set ht [winfo height $t]
    set hs [winfo height $sb]
    wm withdraw .
    # Gleiche Hoehe, und nicht bloss ein paar Pixel.
    list [expr {$hs == $ht}] [expr {$hs > 50}]
} -result {1 1}

