adressbuch::schliessen
test gui-11.1 {CardDAV: Server und Benutzer werden gemerkt, das Kennwort NICHT} \
        -constraints {tk tbl} -body {
    # Ein Kennwort in einer Klartextdatei neben den Adressen waere
    # bequem und falsch: wer sie liest, hat den Zugang zum ganzen
    # Server. Wer es nicht jedesmal tippen will, nimmt den
    # Schluesselbund seines Systems -- das ist ein eigener Schritt.
    frischGui
    array set ::ab::dav {url http://beispiel.invalid pfad /a/ \
            user greg pass sehrgeheim}
    # Nur das Merken pruefen, ohne Netz: die Zuweisung steht in
    # davHolen NACH dem erfolgreichen Holen, darum hier von Hand.
    abconf::setz dav url      $::ab::dav(url)
    abconf::setz dav pfad     $::ab::dav(pfad)
    abconf::setz dav benutzer $::ab::dav(user)
    set f [makeFile {} dav-conf.conf]
    set ::env(ADRESSBUCH_CONF) $f
    abconf::speichern
    set fh [open $f r] ; set t [read $fh] ; close $fh
    unset ::env(ADRESSBUCH_CONF)
    list [string match *beispiel.invalid* $t] [string match *greg* $t] \
         [string match *sehrgeheim* $t]
} -result {1 1 0}

test gui-11.2 {ein nicht erreichbarer Server meldet es und aendert nichts} \
        -constraints {tk tbl} -body {
    frischGui
    adressbuch::schreiben "" {vorname A name B}
    ::ab::listeFuellen
    array set ::ab::dav {url http://127.0.0.1:1 pfad /x/ user "" pass ""}
    set r [::ab::davHolen]
    list $r [llength [adressbuch::alle]] \
         [string match "*Nicht geholt:*" $::ab::status]
} -result {0 1 1}

