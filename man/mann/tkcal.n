.TH tkcal n 0.28.0 tkutils "Tcl/Tk Utility Library"
.SH NAME
tkutils::tkcal \- calendar view
.SH SYNOPSIS
package require tkutils::tkcal
.br
set w [::tkutils::tkcal::widget .w]
.SH DESCRIPTION
Tk front-end built on the tclutils calendar engine (tucal). See docs/tkcal.md.
.SH "SEE ALSO"
tclutils(n)
.SH KEYWORDS
Tk, widget, calendar
