.TH tkubase64 n 0.28.0 tkutils "Tcl/Tk Utility Library"
.SH NAME
tkutils::tkubase64 \- Base64 encode/decode panel
.SH SYNOPSIS
package require tkutils::tkubase64
.br
set w [::tkutils::tkubase64::widget .w]
.SH DESCRIPTION
Tk front-end built on the tclutils Base64 engine (tubase64). See docs/tkubase64.md.
.SH "SEE ALSO"
tclutils(n)
.SH KEYWORDS
Tk, widget, base64
