.TH tkzip n 0.28.0 tkutils "Tcl/Tk Utility Library"
.SH NAME
tkutils::tkzip \- ZIP archive browser
.SH SYNOPSIS
package require tkutils::tkzip
.br
set w [::tkutils::tkzip::widget .w]
.SH DESCRIPTION
Tk front-end built on the tclutils ZIP engine (tuzip). See docs/tkzip.md.
.SH "SEE ALSO"
tclutils(n)
.SH KEYWORDS
Tk, widget, zip
