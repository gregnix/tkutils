package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkbase64 }

test tkbase64-1.1 {encode} -constraints haveTk -body {
    catch {destroy .b}
    set w [::tkutils::tkbase64::widget .b]
    ::tkutils::tkbase64::setInput $w "Hello"
    ::tkutils::tkbase64::encode $w
} -result SGVsbG8=

test tkbase64-1.2 {decode} -constraints haveTk -body {
    catch {destroy .b}
    set w [::tkutils::tkbase64::widget .b]
    ::tkutils::tkbase64::setInput $w "SGVsbG8="
    ::tkutils::tkbase64::decode $w
} -result Hello

test tkbase64-1.3 {round-trip} -constraints haveTk -body {
    catch {destroy .b}
    set w [::tkutils::tkbase64::widget .b]
    ::tkutils::tkbase64::setInput $w "Round-Trip-123"
    set enc [::tkutils::tkbase64::encode $w]
    ::tkutils::tkbase64::setInput $w $enc
    ::tkutils::tkbase64::decode $w
} -result Round-Trip-123

test tkbase64-1.4 {getOutput reflects last op} -constraints haveTk -body {
    catch {destroy .b}
    set w [::tkutils::tkbase64::widget .b]
    ::tkutils::tkbase64::setInput $w "Hi"
    ::tkutils::tkbase64::encode $w
    ::tkutils::tkbase64::getOutput $w
} -result SGk=

cleanupTests
