package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkcal }

test tkcal-1.1 {initial month} -constraints haveTk -body {
    catch {destroy .c}
    set w [::tkutils::tkcal::widget .c -year 2026 -month 6]
    ::tkutils::tkcal::getMonth $w
} -result {2026 6}

test tkcal-1.2 {render text mentions the year} -constraints haveTk -body {
    catch {destroy .c}
    set w [::tkutils::tkcal::widget .c -year 2026 -month 6]
    string match *2026* [::tkutils::tkcal::getText $w]
} -result 1

test tkcal-1.3 {next wraps the year} -constraints haveTk -body {
    catch {destroy .c}
    set w [::tkutils::tkcal::widget .c -year 2026 -month 12]
    ::tkutils::tkcal::next $w
} -result {2027 1}

test tkcal-1.4 {prev wraps the year} -constraints haveTk -body {
    catch {destroy .c}
    set w [::tkutils::tkcal::widget .c -year 2026 -month 1]
    ::tkutils::tkcal::prev $w
} -result {2025 12}

test tkcal-1.5 {invalid month rejected} -constraints haveTk -body {
    catch {destroy .c}
    set w [::tkutils::tkcal::widget .c -year 2026 -month 6]
    catch {::tkutils::tkcal::setMonth $w 2026 13}
} -result 1

test tkcal-1.6 {weeknumbers option adds a week-number column} -constraints haveTk -body {
    catch {destroy .c}
    set w [::tkutils::tkcal::widget .c -year 2026 -month 6 -weeknumbers 1]
    set ok 0
    foreach l [split [::tkutils::tkcal::getText $w] \n] {
        if {[regexp {^\d\d } $l]} { set ok 1; break }
    }
    set ok
} -result 1

cleanupTests
