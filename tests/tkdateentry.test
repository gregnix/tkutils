package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
if {$haveTk} { package require tkutils::tkdateentry }

test tkdateentry-1.1 {setDate/getDate round-trip (ISO)} -constraints haveTk -body {
    catch {destroy .de}
    set w [::tkutils::tkdateentry::widget .de]
    ::tkutils::tkdateentry::setDate $w 2024-03-15
    list [::tkutils::tkdateentry::getText $w] [::tkutils::tkdateentry::getDate $w]
} -result {2024-03-15 2024-03-15}

test tkdateentry-1.2 {custom -dateformat: text formatted, getDate ISO} -constraints haveTk -body {
    catch {destroy .de}
    set w [::tkutils::tkdateentry::widget .de -dateformat "%d.%m.%Y"]
    ::tkutils::tkdateentry::setDate $w 2024-03-15
    list [::tkutils::tkdateentry::getText $w] [::tkutils::tkdateentry::getDate $w]
} -result {15.03.2024 2024-03-15}

test tkdateentry-1.3 {clear empties; getDate is ""} -constraints haveTk -body {
    catch {destroy .de}
    set w [::tkutils::tkdateentry::widget .de]
    ::tkutils::tkdateentry::setDate $w 2024-03-15
    ::tkutils::tkdateentry::clear $w
    list [::tkutils::tkdateentry::getText $w] [::tkutils::tkdateentry::getDate $w]
} -result {{} {}}

test tkdateentry-1.4 {today matches system date} -constraints haveTk -body {
    catch {destroy .de}
    set w [::tkutils::tkdateentry::widget .de]
    ::tkutils::tkdateentry::today $w
    expr {[::tkutils::tkdateentry::getDate $w] eq [clock format [clock seconds] -format %Y-%m-%d]}
} -result 1

test tkdateentry-1.5 {invalid ISO errors} -constraints haveTk -body {
    catch {destroy .de}
    set w [::tkutils::tkdateentry::widget .de]
    catch {::tkutils::tkdateentry::setDate $w "nope"} e o
    dict get $o -errorcode
} -result {TKUTILS TKDATEENTRY DATE}

test tkdateentry-2.1 {popup opens and a pick sets the date, fires -command, closes} -constraints haveTk -body {
    catch {destroy .de}
    set ::picked ""
    set w [::tkutils::tkdateentry::widget .de -command {set ::picked}]
    ::tkutils::tkdateentry::setDate $w 2024-03-15
    ::tkutils::tkdateentry::_show $w
    set opened [winfo exists $w.pop]
    ::tkutils::tkdateentry::_pick $w 2024-03-20
    list $opened [winfo exists $w.pop] [::tkutils::tkdateentry::getDate $w] $::picked
} -result {1 0 2024-03-20 2024-03-20}

test tkdateentry-2.2 {month navigation wraps the year} -constraints haveTk -body {
    catch {destroy .de}
    set w [::tkutils::tkdateentry::widget .de]
    ::tkutils::tkdateentry::setDate $w 2024-12-10
    ::tkutils::tkdateentry::_show $w
    ::tkutils::tkdateentry::_nav $w 1
    set r [list $::tkutils::tkdateentry::state($w,py) $::tkutils::tkdateentry::state($w,pm)]
    ::tkutils::tkdateentry::_hide $w
    set r
} -result {2025 1}

cleanupTests
