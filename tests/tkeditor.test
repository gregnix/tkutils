package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkeditor }

test tkeditor-1.1 {setText/getText round-trip} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "Hello\nWorld"
    ::tkutils::tkeditor::getText $w
} -result "Hello\nWorld"

test tkeditor-1.2 {modified flag} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "abc"
    set b [::tkutils::tkeditor::isModified $w]
    $w.t insert end "X"
    set c [::tkutils::tkeditor::isModified $w]
    list $b $c
} -result {0 1}

test tkeditor-1.3 {find returns index} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "foo bar baz"
    ::tkutils::tkeditor::find $w "bar"
} -result 1.4

test tkeditor-1.4 {find -nocase} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "Hello"
    list [::tkutils::tkeditor::find $w "hello"] [::tkutils::tkeditor::find $w "hello" -nocase]
} -result {{} 1.0}

test tkeditor-1.5 {loadFile/saveFile round-trip} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir in.txt]
    set out [file join $dir out.txt]
    ::tclutils::common::writeFile $in "alpha\nbeta\ngamma\n"
    ::tkutils::tkeditor::loadFile $w $in
    ::tkutils::tkeditor::saveFile $w $out
    expr {[::tclutils::common::readFile $out] eq [::tclutils::common::readFile $in]}
} -result 1

test tkeditor-2.1 {context menu is a Menu widget} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    winfo class [::tkutils::tkeditor::menuWidget $w]
} -result Menu

test tkeditor-2.2 {menu has standard edit entries} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    expr {![catch {$w.ctx index "Copy"}] && ![catch {$w.ctx index "Paste"}]}
} -result 1

test tkeditor-2.3 {selectAll selects whole buffer} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "abcdef"
    ::tkutils::tkeditor::selectAll $w
    $w.t tag ranges sel
} -result {1.0 1.6}

test tkeditor-2.4 {Select All via menu entry} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "hello"
    $w.ctx invoke [$w.ctx index "Select All"]
    $w.t tag ranges sel
} -result {1.0 1.5}

test tkeditor-2.5 {Undo via menu entry} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "x"
    $w.t edit separator
    $w.t insert end-1c "Y"
    $w.t edit separator
    $w.ctx invoke [$w.ctx index "Undo"]
    ::tkutils::tkeditor::getText $w
} -result x

test tkeditor-2.6 {addMenuItem extends the menu} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::addMenuItem $w "Reformat" {list}
    expr {![catch {$w.ctx index "Reformat"}]}
} -result 1

test tkeditor-3.1 {findAll lists every match} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "ab ab ab"
    ::tkutils::tkeditor::findAll $w "ab"
} -result {1.0 1.3 1.6}

test tkeditor-3.2 {findNext walks matches and wraps} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "ab ab"
    $w.t mark set insert 1.0
    set a [::tkutils::tkeditor::findNext $w "ab"]
    set b [::tkutils::tkeditor::findNext $w "ab"]
    set c [::tkutils::tkeditor::findNext $w "ab"]
    list $a $b $c
} -result {1.0 1.3 1.0}

test tkeditor-3.3 {replace first match only} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "ab ab ab"
    set n [::tkutils::tkeditor::replace $w "ab" "X"]
    list $n [::tkutils::tkeditor::getText $w]
} -result {1 {X ab ab}}

test tkeditor-3.4 {replace all matches} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "ab ab ab"
    set n [::tkutils::tkeditor::replace $w "ab" "X" -all]
    list $n [::tkutils::tkeditor::getText $w]
} -result {3 {X X X}}

test tkeditor-3.5 {replace does not re-match its own replacement} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "a a"
    set n [::tkutils::tkeditor::replace $w "a" "aa" -all]
    list $n [::tkutils::tkeditor::getText $w]
} -result {2 {aa aa}}

test tkeditor-3.6 {highlightAll tags all matches} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "ab ab"
    set n [::tkutils::tkeditor::highlightAll $w "ab"]
    list $n [llength [$w.t tag ranges match]]
} -result {2 4}

test tkeditor-3.7 {clearHighlight removes the tag ranges} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "ab ab"
    ::tkutils::tkeditor::highlightAll $w "ab"
    ::tkutils::tkeditor::clearHighlight $w
    $w.t tag ranges match
} -result {}

test tkeditor-3.8 {gotoLine moves the cursor; cursor reports it} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "l1\nl2\nl3"
    ::tkutils::tkeditor::gotoLine $w 3
    ::tkutils::tkeditor::cursor $w
} -result 3.0

test tkeditor-3.9 {readonly blocks typed edits but setText still works} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkeditor::widget .e]
    ::tkutils::tkeditor::setText $w "x"
    ::tkutils::tkeditor::readonly $w 1
    catch {$w.t insert end "Y"}
    set afterInsert [::tkutils::tkeditor::getText $w]
    ::tkutils::tkeditor::setText $w "new"
    list [::tkutils::tkeditor::readonly $w] $afterInsert [::tkutils::tkeditor::getText $w]
} -result {1 x new}

cleanupTests
