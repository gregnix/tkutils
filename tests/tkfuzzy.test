package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkfuzzy }

set items {readme.txt data.csv note.md report.pdf description.txt}

test tkfuzzy-1.1 {empty pattern shows all} -constraints haveTk -body {
    catch {destroy .f}
    set w [::tkutils::tkfuzzy::widget .f]
    ::tkutils::tkfuzzy::setItems $w $items
    llength [::tkutils::tkfuzzy::filter $w ""]
} -result 5

test tkfuzzy-1.2 {subsequence filter} -constraints haveTk -body {
    catch {destroy .f}
    set w [::tkutils::tkfuzzy::widget .f]
    ::tkutils::tkfuzzy::setItems $w $items
    lsort [::tkutils::tkfuzzy::filter $w "dt"]
} -result {data.csv description.txt readme.txt}

test tkfuzzy-1.3 {single match} -constraints haveTk -body {
    catch {destroy .f}
    set w [::tkutils::tkfuzzy::widget .f]
    ::tkutils::tkfuzzy::setItems $w $items
    ::tkutils::tkfuzzy::filter $w "note"
} -result note.md

test tkfuzzy-1.4 {no match} -constraints haveTk -body {
    catch {destroy .f}
    set w [::tkutils::tkfuzzy::widget .f]
    ::tkutils::tkfuzzy::setItems $w $items
    ::tkutils::tkfuzzy::filter $w "zzz"
} -result {}

test tkfuzzy-1.5 {no selection} -constraints haveTk -body {
    catch {destroy .f}
    set w [::tkutils::tkfuzzy::widget .f]
    ::tkutils::tkfuzzy::setItems $w $items
    ::tkutils::tkfuzzy::getSelection $w
} -result {}

cleanupTests
