package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
set haveEng [expr {$haveTk && ![catch {package require tclutils::tuini 0.1}]}]
testConstraint ini $haveEng
if {$haveEng} { package require tkutils::tkini }

set ini "global1 = g1\n\[server\]\nhost = localhost\nport = 8080\n\[db\]\nname = test\n"

test tkini-1.1 {loadText counts sections} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkini::widget .i]
    set n [::tkutils::tkini::loadText $w $ini]
    list $n [::tkutils::tkini::sections $w]
} -result {3 {{} server db}}

test tkini-1.2 {selectSection shows key/value rows} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::selectSection $w server
    set kv [::tkutils::tkini::treeWidget $w]
    set rows [$kv children {}]
    set first [lindex $rows 0]
    list [llength $rows] [$kv item $first -text] [$kv item $first -values]
} -result {2 host localhost}

test tkini-1.3 {currentSection} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::selectSection $w db
    ::tkutils::tkini::currentSection $w
} -result db

test tkini-1.4 {global section keys} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::selectSection $w ""
    set kv [::tkutils::tkini::treeWidget $w]
    set first [lindex [$kv children {}] 0]
    list [$kv item $first -text] [$kv item $first -values]
} -result {global1 g1}

test tkini-2.1 {setKey adds/updates a value} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::setKey $w server timeout 30
    ::tclutils::tuini::get [::tkutils::tkini::data $w] server timeout
} -result 30

test tkini-2.2 {removeKey} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::removeKey $w server port
    ::tclutils::tuini::keys [::tkutils::tkini::data $w] server
} -result host

test tkini-2.3 {addSection / removeSection} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::addSection $w cache
    set s1 [::tkutils::tkini::sections $w]
    ::tkutils::tkini::removeSection $w db
    list $s1 [::tkutils::tkini::sections $w]
} -result {{{} server db cache} {{} server cache}}

test tkini-2.4 {toText reflects edits} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkini::widget .i]
    ::tkutils::tkini::loadText $w $ini
    ::tkutils::tkini::setKey $w server host 9.9.9.9
    ::tclutils::tuini::get [::tclutils::tuini::parse [::tkutils::tkini::toText $w]] server host
} -result 9.9.9.9

cleanupTests
