package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
set haveNotes 1
if {[catch {package require tclutils::tunotes 0.1}]} { set haveNotes 0 }
testConstraint notes [expr {$haveTk && $haveNotes}]
if {$haveTk && $haveNotes} { package require tkutils::tknotes }

test tknotes-1.1 {addRoot returns id, count} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set id [::tkutils::tknotes::addRoot $w "First" "body"]
    list [::tkutils::tknotes::count $w] [expr {$id ne ""}]
} -result {1 1}

test tknotes-1.2 {addChild nests in the tree} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "Root" ""]
    set c [::tkutils::tknotes::addChild $w $r "Kid" ""]
    set tv [::tkutils::tknotes::treeWidget $w]
    list [llength [$tv children {}]] [llength [$tv children $r]] \
         [expr {[$tv parent $c] eq $r}]
} -result {1 1 1}

test tknotes-1.3 {select loads editor title} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "Hello" "text"]
    ::tkutils::tknotes::select $w $r
    set ::tkutils::tknotes::state($w,title)
} -result Hello

test tknotes-1.4 {commit persists editor edits} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "Old" "oldbody"]
    ::tkutils::tknotes::select $w $r
    set ::tkutils::tknotes::state($w,title) "New Title"
    set ::tkutils::tknotes::state($w,tags) "a b"
    $w.pw.r.content delete 1.0 end
    $w.pw.r.content insert end "fresh body"
    ::tkutils::tknotes::commit $w
    set n [::tclutils::tunotes::get [::tkutils::tknotes::store $w] $r]
    list [dict get $n title] [dict get $n tags] [dict get $n content]
} -result {{New Title} {a b} {fresh body}}

test tknotes-1.5 {delete cascade clears subtree} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "R" ""]
    ::tkutils::tknotes::addChild $w $r "C" ""
    ::tkutils::tknotes::delete $w $r 1
    ::tkutils::tknotes::count $w
} -result 0

test tknotes-1.6 {search finds by content} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    ::tkutils::tknotes::addRoot $w "Alpha" "needle here"
    ::tkutils::tknotes::addRoot $w "Beta" "nothing"
    llength [::tkutils::tknotes::search $w "needle"]
} -result 1

test tknotes-1.7 {save/load file round-trip} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "Root" "x"]
    ::tkutils::tknotes::addChild $w $r "Kid" "y"
    set f [file join [makeDirectory nd] notes.json]
    ::tkutils::tknotes::save $w $f
    catch {destroy .n2}
    set w2 [::tkutils::tknotes::widget .n2]
    set loaded [::tkutils::tknotes::load $w2 $f]
    set tv [::tkutils::tknotes::treeWidget $w2]
    list $loaded [llength [$tv children {}]] [llength [$tv children $r]]
} -result {2 1 1}

test tknotes-1.8 {store getter returns the note dict} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "T" "B"]
    dict get [::tclutils::tunotes::get [::tkutils::tknotes::store $w] $r] title
} -result T

test tknotes-2.1 {-toolbar 0 hides the built-in bar but ops still work} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n -toolbar 0]
    set id [::tkutils::tknotes::addRoot $w "X" ""]
    list [winfo exists $w.bar] [::tkutils::tknotes::count $w]
} -result {0 1}

test tknotes-2.2 {move reparents within the widget} -constraints notes -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r1 [::tkutils::tknotes::addRoot $w "R1" ""]
    set r2 [::tkutils::tknotes::addRoot $w "R2" ""]
    set c  [::tkutils::tknotes::addChild $w $r1 "C" ""]
    ::tkutils::tknotes::move $w $c $r2
    set tv [::tkutils::tknotes::treeWidget $w]
    list [expr {[$tv parent $c] eq $r2}] [llength [$tv children $r1]]
} -result {1 0}

test tknotes-2.1 {expandAll / collapseAll toggle -open} -constraints haveTk -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "r" ""]
    ::tkutils::tknotes::addChild $w $r "c" ""
    ::tkutils::tknotes::collapseAll $w
    set tv [::tkutils::tknotes::treeWidget $w]
    set o1 [$tv item $r -open]
    ::tkutils::tknotes::expandAll $w
    set o2 [$tv item $r -open]
    list $o1 $o2
} -result {0 1}

test tknotes-2.2 {tags + byTag} -constraints haveTk -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set a [::tkutils::tknotes::addRoot $w "a" ""]
    ::tkutils::tknotes::addTag $w $a urgent
    list [::tkutils::tknotes::tags $w] [expr {[::tkutils::tknotes::byTag $w urgent] eq $a}]
} -result {urgent 1}

test tknotes-2.3 {addTag / removeTag reflect in store} -constraints haveTk -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set a [::tkutils::tknotes::addRoot $w "a" ""]
    ::tkutils::tknotes::addTag $w $a x
    ::tkutils::tknotes::addTag $w $a y
    ::tkutils::tknotes::removeTag $w $a x
    dict get [::tclutils::tunotes::get [::tkutils::tknotes::store $w] $a] tags
} -result y

test tknotes-2.4 {subtree + saveSubtree round-trip} -constraints haveTk -body {
    catch {destroy .n}
    set w [::tkutils::tknotes::widget .n]
    set r [::tkutils::tknotes::addRoot $w "r" ""]
    set c [::tkutils::tknotes::addChild $w $r "c" ""]
    ::tkutils::tknotes::addChild $w $c "g" ""
    set n1 [dict size [::tkutils::tknotes::subtree $w $c]]
    set ffile [file join [makeDirectory ntd] sub.json]
    ::tkutils::tknotes::saveSubtree $w $c $ffile
    set n2 [::tclutils::tunotes::count [::tclutils::tunotes::load $ffile]]
    list $n1 $n2
} -result {2 2}

cleanupTests
