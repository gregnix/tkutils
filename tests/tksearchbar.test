package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
if {$haveTk} { package require tkutils::tksearchbar }

test tksearchbar-1.1 {empty initially} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tksearchbar::widget .s]
    ::tkutils::tksearchbar::getText $w
} -result ""

test tksearchbar-1.2 {setText sets text without firing} -constraints haveTk -body {
    catch {destroy .s}
    set ::fired 0
    set w [::tkutils::tksearchbar::widget .s -command {set ::fired 1}]
    ::tkutils::tksearchbar::setText $w abc
    list [::tkutils::tksearchbar::getText $w] $::fired
} -result {abc 0}

test tksearchbar-1.3 {clear empties and fires} -constraints haveTk -body {
    catch {destroy .s}
    set ::got NONE
    set w [::tkutils::tksearchbar::widget .s -command [list apply {{t f} {set ::got [list $t $f]}}]]
    ::tkutils::tksearchbar::setText $w x
    ::tkutils::tksearchbar::clear $w
    list [::tkutils::tksearchbar::getText $w] $::got
} -result {{} {{} {}}}

test tksearchbar-2.1 {debounced fire delivers text after the delay} -constraints haveTk -body {
    catch {destroy .s}
    set ::got NONE
    set w [::tkutils::tksearchbar::widget .s -delay 40 \
        -command [list apply {{t f} {set ::got [list $t $f]}}]]
    ::tkutils::tksearchbar::setText $w hello
    ::tkutils::tksearchbar::_onChange $w
    after 130 {set ::wait 1}; vwait ::wait
    set ::got
} -result {hello {}}

test tksearchbar-2.2 {Return-style fire is immediate} -constraints haveTk -body {
    catch {destroy .s}
    set ::got NONE
    set w [::tkutils::tksearchbar::widget .s \
        -command [list apply {{t f} {set ::got [list $t $f]}}]]
    ::tkutils::tksearchbar::setText $w q
    ::tkutils::tksearchbar::_fire $w
    set ::got
} -result {q {}}

test tksearchbar-3.1 {filters: default is first; setFilter changes} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tksearchbar::widget .s -filters {All Active Done}]
    set a [::tkutils::tksearchbar::getFilter $w]
    ::tkutils::tksearchbar::setFilter $w Done
    list $a [::tkutils::tksearchbar::getFilter $w]
} -result {All Done}

test tksearchbar-3.2 {command receives text and filter} -constraints haveTk -body {
    catch {destroy .s}
    set ::got NONE
    set w [::tkutils::tksearchbar::widget .s -filters {A B} \
        -command [list apply {{t f} {set ::got [list $t $f]}}]]
    ::tkutils::tksearchbar::setText $w z
    ::tkutils::tksearchbar::_fire $w
    set ::got
} -result {z A}

cleanupTests
