package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set haveSqlite 1
if {[catch {package require sqlite3}]} { set haveSqlite 0 }
testConstraint tksqlite [expr {$haveTk && $haveSqlite}]
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk && $haveSqlite} { package require tkutils::tksqlite }

proc makeDb {} {
    set dbfile [file join [makeDirectory sqdb] t.db]
    file delete -force $dbfile
    sqlite3 setupdb $dbfile
    setupdb eval {CREATE TABLE t(id INTEGER, name TEXT)}
    setupdb eval {INSERT INTO t VALUES(1,'a'),(2,'b')}
    setupdb eval {CREATE TABLE u(x)}
    setupdb close
    return $dbfile
}

test tksqlite-1.1 {openFile counts tables} -constraints tksqlite -body {
    catch {destroy .s}
    set w [::tkutils::tksqlite::widget .s]
    ::tkutils::tksqlite::openFile $w [makeDb]
} -result 2

test tksqlite-1.2 {table names} -constraints tksqlite -body {
    catch {destroy .s}
    set w [::tkutils::tksqlite::widget .s]
    ::tkutils::tksqlite::openFile $w [makeDb]
    ::tkutils::tksqlite::tables $w
} -result {t u}

test tksqlite-1.3 {showTable row count} -constraints tksqlite -body {
    catch {destroy .s}
    set w [::tkutils::tksqlite::widget .s]
    ::tkutils::tksqlite::openFile $w [makeDb]
    ::tkutils::tksqlite::showTable $w t
} -result 2

test tksqlite-1.4 {row values} -constraints tksqlite -body {
    catch {destroy .s}
    set w [::tkutils::tksqlite::widget .s]
    ::tkutils::tksqlite::openFile $w [makeDb]
    ::tkutils::tksqlite::showTable $w t
    ::tkutils::tksqlite::getRows $w
} -result {{1 a} {2 b}}

cleanupTests
