package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkstatus }

test tkstatus-1.1 {setText/getText} -constraints haveTk -body {
    catch {destroy .st}
    set w [::tkutils::tkstatus::widget .st]
    ::tkutils::tkstatus::setText $w "Ready"
    ::tkutils::tkstatus::getText $w
} -result Ready

test tkstatus-1.2 {named field} -constraints haveTk -body {
    catch {destroy .st}
    set w [::tkutils::tkstatus::widget .st]
    ::tkutils::tkstatus::addField $w pos -width 12
    ::tkutils::tkstatus::setField $w pos "Ln 1, Col 1"
    ::tkutils::tkstatus::fieldText $w pos
} -result {Ln 1, Col 1}

test tkstatus-1.3 {progress value} -constraints haveTk -body {
    catch {destroy .st}
    set w [::tkutils::tkstatus::widget .st]
    ::tkutils::tkstatus::progress $w 50
    expr {[$w.row.pb cget -value] == 50}
} -result 1

test tkstatus-1.4 {progress hide} -constraints haveTk -body {
    catch {destroy .st}
    set w [::tkutils::tkstatus::widget .st]
    ::tkutils::tkstatus::progress $w 50
    ::tkutils::tkstatus::progress $w ""
    expr {[winfo manager $w.row.pb] eq ""}
} -result 1

test tkstatus-1.5 {flash shows text immediately; underlying unchanged} -constraints haveTk -body {
    catch {destroy .st}
    set w [::tkutils::tkstatus::widget .st]
    ::tkutils::tkstatus::setText $w "Idle"
    ::tkutils::tkstatus::flash $w "Saved!" 5000
    set shown [$w.row.main cget -text]
    set under [::tkutils::tkstatus::getText $w]
    destroy .st
    list $shown $under
} -result {Saved! Idle}

cleanupTests
