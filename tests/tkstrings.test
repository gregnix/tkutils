package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkstrings }

set sample "ab\x00GoodLongString\x00Hi"

test tkstrings-1.1 {default minlength keeps only long strings} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkstrings::widget .s]
    ::tkutils::tkstrings::setData $w $sample
    ::tkutils::tkstrings::getStrings $w
} -result GoodLongString

test tkstrings-1.2 {count returned} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkstrings::widget .s]
    ::tkutils::tkstrings::setData $w $sample
} -result 1

test tkstrings-1.3 {minlength 2 keeps short strings too} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkstrings::widget .s]
    ::tkutils::tkstrings::setData $w $sample -minlength 2
    ::tkutils::tkstrings::getStrings $w
} -result {ab GoodLongString Hi}

test tkstrings-1.4 {loadFile} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkstrings::widget .s]
    set f [file join [makeDirectory sd] data.bin]
    set ch [open $f wb]
    fconfigure $ch -translation binary -encoding iso8859-1
    puts -nonewline $ch "xx\x00LongEnoughString\x00"
    close $ch
    ::tkutils::tkstrings::loadFile $w $f
    ::tkutils::tkstrings::getStrings $w
} -result LongEnoughString

cleanupTests
