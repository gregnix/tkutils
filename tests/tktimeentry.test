package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
tcl::tm::path add [file normalize [file join [file dirname [file normalize [info script]]] .. lib tm]]
if {$haveTk} { package require tkutils::tktimeentry }

test tktimeentry-1.1 {default 00:00} -constraints haveTk -body {
    catch {destroy .t}; set w [::tkutils::tktimeentry::widget .t]
    ::tkutils::tktimeentry::getTime $w
} -result 00:00
test tktimeentry-1.2 {setTime/getTime} -constraints haveTk -body {
    catch {destroy .t}; set w [::tkutils::tktimeentry::widget .t]
    ::tkutils::tktimeentry::setTime $w 09:30
} -result 09:30
test tktimeentry-1.3 {zero-pad single digits} -constraints haveTk -body {
    catch {destroy .t}; set w [::tkutils::tktimeentry::widget .t]
    ::tkutils::tktimeentry::setTime $w 9:5
} -result 09:05
test tktimeentry-1.4 {seconds variant} -constraints haveTk -body {
    catch {destroy .t}; set w [::tkutils::tktimeentry::widget .t -seconds 1 -time 09:30:15]
    ::tkutils::tktimeentry::getTime $w
} -result 09:30:15
test tktimeentry-1.5 {out of range errors} -constraints haveTk -body {
    catch {destroy .t}; set w [::tkutils::tktimeentry::widget .t]
    catch {::tkutils::tktimeentry::setTime $w 25:00} e o; dict get $o -errorcode
} -result {TKUTILS TKTIMEENTRY TIME}
test tktimeentry-2.1 {change fires command} -constraints haveTk -body {
    catch {destroy .t}; set ::got ""
    set w [::tkutils::tktimeentry::widget .t -command {set ::got}]
    ::tkutils::tktimeentry::setTime $w 08:15
    ::tkutils::tktimeentry::_onChange $w
    set ::got
} -result 08:15
cleanupTests
