package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
if {[info exists ::env(TKUTILS_TM)]} { catch {tcl::tm::path add $::env(TKUTILS_TM)} }
catch {tcl::tm::path remove $tmDir}
tcl::tm::path add $tmDir
if {$haveTk} { package require tkutils::tkuaction }

set ns ::tkutils::tkuaction

# --- definition / lookup ---------------------------------------------------

test tkuaction-1.1 {define then exists/get} -constraints haveTk -body {
    $::ns\::reset
    $::ns\::define save -label "Save" -accelerator "Ctrl+S"
    list [$::ns\::exists save] [$::ns\::get save label] [$::ns\::get save tooltip]
} -result {1 Save {Save (Ctrl+S)}}

test tkuaction-1.2 {names lists defined actions} -constraints haveTk -body {
    $::ns\::reset
    $::ns\::define a; $::ns\::define b
    lsort [$::ns\::names]
} -result {a b}

test tkuaction-1.3 {get of unknown action errors} -constraints haveTk -body {
    $::ns\::reset
    catch {$::ns\::get nope} m o
    dict get $o -errorcode
} -result {TKUTILS TKUACTION NOACTION}

test tkuaction-1.4 {define rejects unknown option} -constraints haveTk -body {
    catch {$::ns\::define x -bogus 1} m o
    dict get $o -errorcode
} -result {TKUTILS TKUACTION OPTION}

# --- invoke / state --------------------------------------------------------

test tkuaction-2.1 {invoke runs the command when enabled} -constraints haveTk -body {
    $::ns\::reset
    set ::ran 0
    $::ns\::define save -command {set ::ran 1}
    $::ns\::invoke save
    set ::ran
} -result 1

test tkuaction-2.2 {disabled action does not invoke} -constraints haveTk -body {
    $::ns\::reset
    set ::ran 0
    $::ns\::define save -command {set ::ran 1} -enabled 0
    $::ns\::invoke save
    set ::ran
} -result 0

test tkuaction-2.3 {checkable action toggles on invoke} -constraints haveTk -body {
    $::ns\::reset
    $::ns\::define wrap -checkable 1
    set a [$::ns\::invoke wrap; $::ns\::getChecked wrap]
    set b [$::ns\::invoke wrap; $::ns\::getChecked wrap]
    list $a $b
} -result {1 0}

# --- registration / propagation -------------------------------------------

test tkuaction-3.1 {setEnabled propagates to a registered widget} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .b}
    pack [ttk::button .b -text Save]
    $::ns\::define save
    $::ns\::register save .b
    $::ns\::setEnabled save 0
    set s1 [.b cget -state]
    $::ns\::setEnabled save 1
    list $s1 [.b cget -state]
} -result {disabled normal}

test tkuaction-3.2 {register on unknown action errors} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .b}
    pack [ttk::button .b]
    catch {$::ns\::register nope .b} m o
    dict get $o -errorcode
} -result {TKUTILS TKUACTION NOACTION}

test tkuaction-3.3 {unregister stops propagation} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .b}
    pack [ttk::button .b -text Save]
    $::ns\::define save
    $::ns\::register save .b
    $::ns\::unregister save .b
    $::ns\::setEnabled save 0
    .b cget -state
} -result normal

test tkuaction-3.4 {setEnabled with a window greys only that toplevel} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .wa .wb}
    toplevel .wa
    toplevel .wb
    ttk::button .wa.b -text Save
    ttk::button .wb.b -text Save
    $::ns\::define save
    $::ns\::register save .wa.b
    $::ns\::register save .wb.b
    $::ns\::setEnabled save 0 .wa
    list [.wa.b cget -state] [.wb.b cget -state] \
         [$::ns\::getEnabled save] [$::ns\::getEnabled save .wa]
} -cleanup { catch {destroy .wa .wb} } -result {disabled normal 1 0}

test tkuaction-3.5 {two-argument setEnabled clears a window override} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .wa .wb}
    toplevel .wa
    toplevel .wb
    ttk::button .wa.b -text Save
    ttk::button .wb.b -text Save
    $::ns\::define save
    $::ns\::register save .wa.b
    $::ns\::register save .wb.b
    $::ns\::setEnabled save 0 .wa
    $::ns\::setEnabled save 1
    list [.wa.b cget -state] [.wb.b cget -state] [$::ns\::getEnabled save .wa]
} -cleanup { catch {destroy .wa .wb} } -result {normal normal 1}

test tkuaction-3.6 {setEnabled unknown window is an error} -constraints haveTk -body {
    $::ns\::reset
    $::ns\::define save
    catch {$::ns\::setEnabled save 0 .gone} m o
    dict get $o -errorcode
} -result {TKUTILS TKUACTION WINDOW}

test tkuaction-3.7 {setEnabled accepts a child of the toplevel} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .wa .wb}
    toplevel .wa
    toplevel .wb
    ttk::button .wa.b -text Save
    ttk::button .wb.b -text Save
    $::ns\::define save
    $::ns\::register save .wa.b
    $::ns\::register save .wb.b
    $::ns\::setEnabled save 0 .wa.b
    list [.wa.b cget -state] [.wb.b cget -state]
} -cleanup { catch {destroy .wa .wb} } -result {disabled normal}

# --- groups ----------------------------------------------------------------

test tkuaction-4.1 {groupSet enables/disables all members} -constraints haveTk -body {
    $::ns\::reset
    $::ns\::define a; $::ns\::define b
    $::ns\::groupDefine edit {a b}
    $::ns\::groupSet edit 0
    list [$::ns\::getEnabled a] [$::ns\::getEnabled b]
} -result {0 0}

test tkuaction-4.2 {groupSet on unknown group errors} -constraints haveTk -body {
    $::ns\::reset
    catch {$::ns\::groupSet nope 1} m o
    dict get $o -errorcode
} -result {TKUTILS TKUACTION NOGROUP}

test tkuaction-4.3 {groupSet with a window scopes every member} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .wa .wb}
    toplevel .wa
    toplevel .wb
    ttk::button .wa.a; ttk::button .wa.b
    ttk::button .wb.a; ttk::button .wb.b
    $::ns\::define a; $::ns\::define b
    $::ns\::register a .wa.a; $::ns\::register a .wb.a
    $::ns\::register b .wa.b; $::ns\::register b .wb.b
    $::ns\::groupDefine edit {a b}
    $::ns\::groupSet edit 0 .wa
    list [.wa.a cget -state] [.wa.b cget -state] \
         [.wb.a cget -state] [.wb.b cget -state]
} -cleanup { catch {destroy .wa .wb} } -result {disabled disabled normal normal}

# --- toolbar integration ---------------------------------------------------

test tkuaction-5.1 {tkutoolbar addAction builds and binds a button} -constraints haveTk -body {
    $::ns\::reset
    package require tkutils::tkutoolbar
    catch {destroy .tb}
    set tb [::tkutils::tkutoolbar::widget .tb]
    set ::opened 0
    $::ns\::define open -label "Open" -command {set ::opened 1}
    set btn [::tkutils::tkutoolbar::addAction $tb open]
    $btn invoke
    $::ns\::setEnabled open 0
    list $::opened [$btn cget -state]
} -result {1 disabled}

# --- menu entries ----------------------------------------------------------

test tkuaction-6.1 {addMenuItem greys the command row} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .mfile}
    menu .mfile -tearoff 0
    $::ns\::define save -label Save -accelerator Ctrl+S
    set idx [$::ns\::addMenuItem .mfile save]
    $::ns\::setEnabled save 0
    .mfile entrycget $idx -state
} -cleanup { catch {destroy .mfile} } -result disabled

test tkuaction-6.2 {setEnabled with a window greys only that menu} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .wa .wb}
    toplevel .wa
    toplevel .wb
    menu .wa.mf -tearoff 0
    menu .wb.mf -tearoff 0
    $::ns\::define save -label Save
    set ia [$::ns\::addMenuItem .wa.mf save]
    set ib [$::ns\::addMenuItem .wb.mf save]
    $::ns\::setEnabled save 0 .wa
    list [.wa.mf entrycget $ia -state] [.wb.mf entrycget $ib -state]
} -cleanup { catch {destroy .wa .wb} } -result {disabled normal}

test tkuaction-6.3 {addMenuItem on unknown action errors} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .mfile}
    menu .mfile -tearoff 0
    catch {$::ns\::addMenuItem .mfile nope} m o
    dict get $o -errorcode
} -cleanup { catch {destroy .mfile} } -result {TKUTILS TKUACTION NOACTION}

test tkuaction-6.4 {unregisterMenu stops propagation} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .mfile}
    menu .mfile -tearoff 0
    $::ns\::define save -label Save
    set idx [$::ns\::addMenuItem .mfile save]
    $::ns\::unregisterMenu save .mfile
    $::ns\::setEnabled save 0
    .mfile entrycget $idx -state
} -cleanup { catch {destroy .mfile} } -result normal

test tkuaction-6.5 {cascade under menubar follows the owner window} -constraints haveTk -body {
    $::ns\::reset
    catch {destroy .wa .wb}
    toplevel .wa
    toplevel .wb
    menu .wa.m -tearoff 0
    .wa configure -menu .wa.m
    menu .wa.m.file -tearoff 0
    .wa.m add cascade -label File -menu .wa.m.file
    menu .wb.m -tearoff 0
    .wb configure -menu .wb.m
    menu .wb.m.file -tearoff 0
    .wb.m add cascade -label File -menu .wb.m.file
    $::ns\::define save -label Save
    set ia [$::ns\::addMenuItem .wa.m.file save]
    set ib [$::ns\::addMenuItem .wb.m.file save]
    $::ns\::setEnabled save 0 .wa
    list [.wa.m.file entrycget $ia -state] [.wb.m.file entrycget $ib -state]
} -cleanup { catch {destroy .wa .wb} } -result {disabled normal}

cleanupTests
