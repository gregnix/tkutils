package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set haveTk [expr {![catch {package require Tk}]}]
if {$haveTk} { catch {wm withdraw .} }

set ok 0
if {$haveTk} {
    set here [file dirname [file normalize [info script]]]
    catch {tcl::tm::path add [file normalize [file join $here .. lib tm]]}
    if {[info exists ::env(TKUTILS_TM)]} { catch {tcl::tm::path add $::env(TKUTILS_TM)} }
    if {![catch {package require tkutils::tkucalc}]} { set ok 1 }
}
testConstraint tk $ok
set ns ::tkutils::tkucalc

# ---- evaluate: the arithmetic core ---------------------------------------
test tkucalc-1.1 {precedence} -constraints tk -body {
    ${ns}::evaluate "2+3*4"
} -result 14

test tkucalc-1.2 {division is floating-point, not integer} -constraints tk -body {
    ${ns}::evaluate "10/4"
} -result 2.5

test tkucalc-1.3 {a whole quotient has no trailing .0} -constraints tk -body {
    ${ns}::evaluate "12/3"
} -result 4

test tkucalc-1.4 {caret is power} -constraints tk -body {
    ${ns}::evaluate "2^10"
} -result 1024

test tkucalc-1.5 {German decimal comma} -constraints tk -body {
    ${ns}::evaluate "3,5 + 1"
} -result 4.5

test tkucalc-1.6 {parentheses} -constraints tk -body {
    ${ns}::evaluate "(1+2)*3"
} -result 9

test tkucalc-1.7 {modulo stays integer} -constraints tk -body {
    ${ns}::evaluate "7 % 3"
} -result 1

test tkucalc-1.8 {on-screen symbols are accepted} -constraints tk -body {
    ${ns}::evaluate "6 \u00f7 2 \u00d7 4"
} -result 12

# ---- evaluate: errors and safety -----------------------------------------
test tkucalc-2.1 {division by zero errors} -constraints tk -body {
    catch {${ns}::evaluate "1/0"} e
    string match {*divide by zero*} $e
} -result 1

test tkucalc-2.2 {letters are rejected} -constraints tk -body {
    catch {${ns}::evaluate "abc"} e
    string match {*invalid characters*} $e
} -result 1

test tkucalc-2.3 {command substitution cannot run commands} -constraints tk -body {
    # brackets are outside the whitelist, so this never reaches expr
    catch {${ns}::evaluate {[exec ls]}} e
    string match {*invalid characters*} $e
} -result 1

test tkucalc-2.4 {variable references are rejected} -constraints tk -body {
    catch {${ns}::evaluate {$env(HOME)}} e
    string match {*invalid characters*} $e
} -result 1

test tkucalc-2.5 {an empty expression errors} -constraints tk -body {
    catch {${ns}::evaluate "   "} e
    string match {*empty*} $e
} -result 1

# ---- widget ---------------------------------------------------------------
test tkucalc-3.1 {widget builds a frame with a display and buttons} -constraints tk -body {
    ${ns}::widget .calc
    set r [list [winfo class .calc] [winfo exists .calc.display]]
    destroy .calc
    set r
} -result {TFrame 1}

test tkucalc-3.2 {pressing keys builds and evaluates an expression} -constraints tk -body {
    ${ns}::widget .calc2
    foreach k {7 \u00d7 8 =} { ${ns}::_press .calc2 $k }
    set r $::tkutils::tkucalc::state(.calc2,text)
    destroy .calc2
    set r
} -result 56

test tkucalc-3.3 {C clears and < backspaces} -constraints tk -body {
    ${ns}::widget .calc3
    foreach k {1 2 3} { ${ns}::_press .calc3 $k }
    ${ns}::_press .calc3 <          ;# -> 12
    set a $::tkutils::tkucalc::state(.calc3,text)
    ${ns}::_press .calc3 C          ;# -> ""
    set b $::tkutils::tkucalc::state(.calc3,text)
    destroy .calc3
    list $a $b
} -result {12 {}}

test tkucalc-3.4 {a bad expression shows Error, not a crash} -constraints tk -body {
    ${ns}::widget .calc4
    foreach k {2 +} { ${ns}::_press .calc4 $k }
    ${ns}::_press .calc4 =
    set r $::tkutils::tkucalc::state(.calc4,text)
    destroy .calc4
    set r
} -result Error

test tkucalc-3.5 {-onresult is called with the result} -constraints tk -body {
    set ::got ""
    ${ns}::widget .calc5 -onresult {apply {{r} {set ::got $r}}}
    foreach k {9 + 1 =} { ${ns}::_press .calc5 $k }
    destroy .calc5
    set ::got
} -result 10


# ---- keyboard + history ---------------------------------------------------
test tkucalc-4.1 {the display entry is editable and Enter evaluates} -constraints tk -body {
    ${ns}::widget .kb
    focus -force .kb.display
    .kb.display insert end "5*6"
    ${ns}::_press .kb =
    set r $::tkutils::tkucalc::state(.kb,text)
    destroy .kb
    set r
} -result 30

test tkucalc-4.2 {buttons do not take keyboard focus} -constraints tk -body {
    ${ns}::widget .kb2
    set r [.kb2.b2_0 cget -takefocus]   ;# the "7" button
    destroy .kb2
    set r
} -result 0

test tkucalc-4.3 {history records each evaluation} -constraints tk -body {
    ${ns}::widget .h1
    foreach k {1 + 2 =} { ${ns}::_press .h1 $k }
    ${ns}::_press .h1 C
    foreach k {3 * 4 =} { ${ns}::_press .h1 $k }
    set r [${ns}::getHistory .h1]
    destroy .h1
    set r
} -result {{1+2 = 3} {3*4 = 12}}

test tkucalc-4.4 {the history panel lists entries} -constraints tk -body {
    ${ns}::widget .h2 -history 1
    foreach k {9 + 1 =} { ${ns}::_press .h2 $k }
    set r [.h2.hist.list get 0 end]
    destroy .h2
    set r
} -result {{9+1 = 10}}

test tkucalc-4.5 {reusing a history line loads its result} -constraints tk -body {
    ${ns}::widget .h3 -history 1
    foreach k {6 × 7 =} { ${ns}::_press .h3 $k }     ;# 42
    ${ns}::clear .h3
    .h3.hist.list selection set 0
    ${ns}::_histReuse .h3
    set r $::tkutils::tkucalc::state(.h3,text)
    destroy .h3
    set r
} -result 42

test tkucalc-4.6 {clearHistory empties the record} -constraints tk -body {
    ${ns}::widget .h4
    foreach k {1 + 1 =} { ${ns}::_press .h4 $k }
    ${ns}::clearHistory .h4
    set r [${ns}::getHistory .h4]
    destroy .h4
    set r
} -result {}

cleanupTests
