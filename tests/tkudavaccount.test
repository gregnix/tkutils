package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
tcl::tm::path add [file normalize [file join [file dirname [file normalize [info script]]] .. lib tm]]
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _r [file dirname [file dirname [file normalize [info script]]]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_r] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c; break
    }
}
set haveDav [expr {$haveTk && ![catch {package require tclutils::tudav 0.1}]}]
testConstraint haveTk $haveDav
if {$haveDav} { package require tkutils::tkudavaccount }

test tkudavaccount-1.1 {build + default config} -constraints haveTk -body {
    catch {destroy .a}; set w [::tkutils::tkudavaccount::widget .a]
    ::tkutils::tkudavaccount::getConfig $w
} -result {url {} user {} password {} type carddav}

test tkudavaccount-1.2 {setConfig round-trips} -constraints haveTk -body {
    catch {destroy .a}; set w [::tkutils::tkudavaccount::widget .a]
    ::tkutils::tkudavaccount::setConfig $w {url http://h/c/ user bob password pw type caldav}
    ::tkutils::tkudavaccount::getConfig $w
} -result {url http://h/c/ user bob password pw type caldav}

test tkudavaccount-1.3 {clear empties credentials} -constraints haveTk -body {
    catch {destroy .a}
    set w [::tkutils::tkudavaccount::widget .a -url http://h/ -user u -password p]
    ::tkutils::tkudavaccount::clear $w
    set c [::tkutils::tkudavaccount::getConfig $w]
    list [dict get $c url] [dict get $c user] [dict get $c password]
} -result {{} {} {}}

test tkudavaccount-2.1 {test with no URL fails and fires -command} -constraints haveTk -body {
    catch {destroy .a}
    set ::res ""
    set w [::tkutils::tkudavaccount::widget .a -command {apply {{ok msg} {set ::res [list $ok $msg]}}}]
    set rc [::tkutils::tkudavaccount::testConnection $w]
    list $rc $::res
} -result {0 {0 {no URL}}}

test tkudavaccount-2.2 {success result sets check + fires ok=1} -constraints haveTk -body {
    catch {destroy .a}
    set ::res ""
    set w [::tkutils::tkudavaccount::widget .a -command {apply {{ok msg} {set ::res [list $ok $msg]}}}]
    ::tkutils::tkudavaccount::_result $w 1 ""
    set ::res
} -result {1 {}}

cleanupTests