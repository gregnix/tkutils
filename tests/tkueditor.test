package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkueditor }

test tkueditor-1.1 {setText/getText round-trip} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "Hello\nWorld"
    ::tkutils::tkueditor::getText $w
} -result "Hello\nWorld"

test tkueditor-1.2 {modified flag} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "abc"
    set b [::tkutils::tkueditor::isModified $w]
    $w.t insert end "X"
    set c [::tkutils::tkueditor::isModified $w]
    list $b $c
} -result {0 1}

test tkueditor-1.3 {find returns index} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "foo bar baz"
    ::tkutils::tkueditor::find $w "bar"
} -result 1.4

test tkueditor-1.4 {find -nocase} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "Hello"
    list [::tkutils::tkueditor::find $w "hello"] [::tkutils::tkueditor::find $w "hello" -nocase]
} -result {{} 1.0}

test tkueditor-1.5 {loadFile/saveFile round-trip} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir in.txt]
    set out [file join $dir out.txt]
    ::tclutils::common::writeFile $in "alpha\nbeta\ngamma\n"
    ::tkutils::tkueditor::loadFile $w $in
    ::tkutils::tkueditor::saveFile $w $out
    expr {[::tclutils::common::readFile $out] eq [::tclutils::common::readFile $in]}
} -result 1

test tkueditor-2.1 {context menu is a Menu widget} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    winfo class [::tkutils::tkueditor::menuWidget $w]
} -result Menu

test tkueditor-2.2 {menu has standard edit entries} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    expr {![catch {$w.ctx index "Copy"}] && ![catch {$w.ctx index "Paste"}]}
} -result 1

test tkueditor-2.3 {selectAll selects whole buffer} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "abcdef"
    ::tkutils::tkueditor::selectAll $w
    $w.t tag ranges sel
} -result {1.0 1.6}

test tkueditor-2.4 {Select All via menu entry} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "hello"
    $w.ctx invoke [$w.ctx index "Select All"]
    $w.t tag ranges sel
} -result {1.0 1.5}

test tkueditor-2.5 {Undo via menu entry} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "x"
    $w.t edit separator
    $w.t insert end-1c "Y"
    $w.t edit separator
    $w.ctx invoke [$w.ctx index "Undo"]
    ::tkutils::tkueditor::getText $w
} -result x

test tkueditor-2.6 {addMenuItem extends the menu} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::addMenuItem $w "Reformat" {list}
    expr {![catch {$w.ctx index "Reformat"}]}
} -result 1

test tkueditor-3.1 {findAll lists every match} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "ab ab ab"
    ::tkutils::tkueditor::findAll $w "ab"
} -result {1.0 1.3 1.6}

test tkueditor-3.2 {findNext walks matches and wraps} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "ab ab"
    $w.t mark set insert 1.0
    set a [::tkutils::tkueditor::findNext $w "ab"]
    set b [::tkutils::tkueditor::findNext $w "ab"]
    set c [::tkutils::tkueditor::findNext $w "ab"]
    list $a $b $c
} -result {1.0 1.3 1.0}

test tkueditor-3.3 {replace first match only} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "ab ab ab"
    set n [::tkutils::tkueditor::replace $w "ab" "X"]
    list $n [::tkutils::tkueditor::getText $w]
} -result {1 {X ab ab}}

test tkueditor-3.4 {replace all matches} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "ab ab ab"
    set n [::tkutils::tkueditor::replace $w "ab" "X" -all]
    list $n [::tkutils::tkueditor::getText $w]
} -result {3 {X X X}}

test tkueditor-3.5 {replace does not re-match its own replacement} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "a a"
    set n [::tkutils::tkueditor::replace $w "a" "aa" -all]
    list $n [::tkutils::tkueditor::getText $w]
} -result {2 {aa aa}}

test tkueditor-3.6 {highlightAll tags all matches} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "ab ab"
    set n [::tkutils::tkueditor::highlightAll $w "ab"]
    list $n [llength [$w.t tag ranges match]]
} -result {2 4}

test tkueditor-3.7 {clearHighlight removes the tag ranges} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "ab ab"
    ::tkutils::tkueditor::highlightAll $w "ab"
    ::tkutils::tkueditor::clearHighlight $w
    $w.t tag ranges match
} -result {}

test tkueditor-3.8 {gotoLine moves the cursor; cursor reports it} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "l1\nl2\nl3"
    ::tkutils::tkueditor::gotoLine $w 3
    ::tkutils::tkueditor::cursor $w
} -result 3.0

test tkueditor-3.9 {readonly blocks typed edits but setText still works} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "x"
    ::tkutils::tkueditor::readonly $w 1
    catch {$w.t insert end "Y"}
    set afterInsert [::tkutils::tkueditor::getText $w]
    ::tkutils::tkueditor::setText $w "new"
    list [::tkutils::tkueditor::readonly $w] $afterInsert [::tkutils::tkueditor::getText $w]
} -result {1 x new}

# --- 0.2: toolbar, status bar, encoding, line endings --------------------

test tkueditor-4.1 {toolbar is built by default and is a real widget} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set tb [::tkutils::tkueditor::toolbarWidget $w]
    list [expr {$tb ne ""}] [winfo exists $tb]
} -result {1 1}

test tkueditor-4.2 {-toolbar 0 omits the toolbar} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e -toolbar 0]
    ::tkutils::tkueditor::toolbarWidget $w
} -result {}

test tkueditor-4.3 {status bar is built by default} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set sb [::tkutils::tkueditor::statusbarWidget $w]
    list [expr {$sb ne ""}] [winfo exists $sb]
} -result {1 1}

test tkueditor-4.4 {-statusbar 0 omits the status bar} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e -statusbar 0]
    ::tkutils::tkueditor::statusbarWidget $w
} -result {}

test tkueditor-4.5 {setStatus sets the main message} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setStatus $w "Ready"
    ::tkutils::tkustatus::getText [::tkutils::tkueditor::statusbarWidget $w]
} -result {Ready}

test tkueditor-4.6 {encoding defaults to utf-8 and is settable} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set a [::tkutils::tkueditor::encoding $w]
    ::tkutils::tkueditor::encoding $w cp1252
    list $a [::tkutils::tkueditor::encoding $w]
} -result {utf-8 cp1252}

test tkueditor-4.7 {eol defaults to lf, is settable, rejects bad values} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set a [::tkutils::tkueditor::eol $w]
    ::tkutils::tkueditor::eol $w crlf
    set b [::tkutils::tkueditor::eol $w]
    set bad [catch {::tkutils::tkueditor::eol $w mac}]
    list $a $b $bad
} -result {lf crlf 1}

test tkueditor-4.8 {refreshStatus updates the position field} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "a\nb\nc"
    ::tkutils::tkueditor::gotoLine $w 2
    ::tkutils::tkustatus::fieldText [::tkutils::tkueditor::statusbarWidget $w] pos
} -result {Ln 2, Col 0}

test tkueditor-4.9 {loadFile decodes utf-8 by default} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir u.txt]
    set fh [open $in wb]
    fconfigure $fh -translation binary
    puts -nonewline $fh [encoding convertto utf-8 "Gr\u00f6\u00dfe\n"]
    close $fh
    ::tkutils::tkueditor::loadFile $w $in
    # "Größe" is five characters when decoded as utf-8
    string length [lindex [split [::tkutils::tkueditor::getText $w] \n] 0]
} -result 5

test tkueditor-4.10 {loadFile detects CRLF and normalises the buffer to LF} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir crlf.txt]
    set fh [open $in wb]
    fconfigure $fh -translation binary
    puts -nonewline $fh "a\r\nb\r\n"
    close $fh
    ::tkutils::tkueditor::loadFile $w $in
    set buf [::tkutils::tkueditor::getText $w]
    list [::tkutils::tkueditor::eol $w] [string first "\r" $buf]
} -result {crlf -1}

test tkueditor-4.11 {loadFile detects LF} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir lf.txt]
    set fh [open $in wb]
    fconfigure $fh -translation binary
    puts -nonewline $fh "a\nb\n"
    close $fh
    ::tkutils::tkueditor::loadFile $w $in
    ::tkutils::tkueditor::eol $w
} -result {lf}

test tkueditor-4.12 {saveFile -eol crlf writes CRLF bytes} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set out [file join $dir out.txt]
    ::tkutils::tkueditor::setText $w "a\nb"
    ::tkutils::tkueditor::saveFile $w $out -eol crlf
    set fh [open $out rb]
    fconfigure $fh -translation binary
    set bytes [read $fh]
    close $fh
    expr {[string first "\r\n" $bytes] >= 0}
} -result 1

test tkueditor-4.13 {encoding round-trip preserves utf-8 bytes} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir u.txt]
    set out [file join $dir o.txt]
    set fh [open $in wb]
    fconfigure $fh -translation binary
    puts -nonewline $fh [encoding convertto utf-8 "Gr\u00f6\u00dfe\n"]
    close $fh
    ::tkutils::tkueditor::loadFile $w $in
    ::tkutils::tkueditor::saveFile $w $out
    set fh [open $out rb]
    fconfigure $fh -translation binary
    set bytes [read $fh]
    close $fh
    expr {$bytes eq [encoding convertto utf-8 "Gr\u00f6\u00dfe\n"]}
} -result 1

test tkueditor-4.14 {setText leaves the cursor at the start} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    ::tkutils::tkueditor::setText $w "alpha\nbeta\ngamma"
    ::tkutils::tkueditor::cursor $w
} -result 1.0

test tkueditor-4.15 {loadFile leaves the cursor at the start} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set dir [makeDirectory ed]
    set in [file join $dir c.txt]
    set fh [open $in wb]
    fconfigure $fh -translation binary
    puts -nonewline $fh "one\ntwo\nthree\n"
    close $fh
    ::tkutils::tkueditor::loadFile $w $in
    ::tkutils::tkueditor::cursor $w
} -result 1.0

test tkueditor-4.16 {toolbar Undo follows the undo stack} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set tb [::tkutils::tkueditor::toolbarWidget $w]
    set ub [::tkutils::tkutoolbar::buttonWidget $tb undo]
    ::tkutils::tkueditor::setText $w "x"
    set before [$ub instate disabled]
    $w.t insert end "Y"
    event generate $w.t <<Modified>>
    list $before [$ub instate disabled]
} -result {1 0}

test tkueditor-4.17 {toolbar Cut/Copy follow the selection} -constraints haveTk -body {
    catch {destroy .e}
    set w [::tkutils::tkueditor::widget .e]
    set tb [::tkutils::tkueditor::toolbarWidget $w]
    set cb [::tkutils::tkutoolbar::buttonWidget $tb cut]
    ::tkutils::tkueditor::setText $w "hello"
    set before [$cb instate disabled]
    $w.t tag add sel 1.0 1.3
    event generate $w.t <<Selection>>
    list $before [$cb instate disabled]
} -result {1 0}

cleanupTests
