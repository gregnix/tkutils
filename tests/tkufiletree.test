package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

# Headless Tk
set haveTk [expr {![catch {package require Tk}]}]
if {$haveTk} { catch {wm withdraw .} }
testConstraint tk $haveTk

if {$haveTk} {
    set here [file dirname [file normalize [info script]]]
    set tmDir [file normalize [file join $here .. lib tm]]
    catch {tcl::tm::path add $tmDir}
    if {[info exists ::env(TKUTILS_TM)]} { catch {tcl::tm::path add $::env(TKUTILS_TM)} }
    # tclutils discovery (CONVENTIONS 11.2): 0.3 needs tclutils::tuprovider
    if {[info exists ::env(TCLUTILS_TM)]} {
        catch {tcl::tm::path add $::env(TCLUTILS_TM)}
    } else {
        set _tkuRoot [file dirname [file dirname $tmDir]]
        foreach _c [lsort -decreasing \
                [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
            tcl::tm::path add $_c
            break
        }
    }
    package require tkutils::tkufiletree
}
set ns ::tkutils::tkufiletree

# Build a fixed directory tree:  root/{a/{x.png,y.txt}, b/c/deep.png, m.png, n.txt, .hidden}
proc mktree {} {
    set r [::tcltest::makeDirectory ft]
    file mkdir [file join $r a] [file join $r b c]
    foreach f {m.png n.txt .hidden a/x.png a/y.txt b/c/deep.png} {
        set p [file join $r $f]
        set ch [open $p w]; close $ch
    }
    return $r
}
proc names {ids} { lmap i $ids {file tail $i} }

test tkufiletree-1.1 {widget builds and exposes the treeview} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r
    set ok [expr {[winfo exists .t] && [winfo exists [$::ns\::treeview .t]]}]
    destroy .t
    set ok
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 1

test tkufiletree-1.2 {top level: directories first, file filter applied} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -filter {*.png}
    set tv [$::ns\::treeview .t]
    set rootid [lindex [$tv children ""] 0]
    set top [lsort [names [$tv children $rootid]]]
    destroy .t
    set top
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {a b m.png}

test tkufiletree-1.3 {subdirectory is not populated until expanded} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -filter {*.png}
    set tv [$::ns\::treeview .t]
    set aid [file join $r a]
    set before [expr {[info exists ${::ns}::state(.t,pop,$aid)] ? [set ${::ns}::state(.t,pop,$aid)] : 0}]
    set ph [llength [$tv children $aid]]
    destroy .t
    list $before $ph
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {0 1}

test tkufiletree-1.4 {expanding a directory populates it (filtered)} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -filter {*.png}
    set tv [$::ns\::treeview .t]
    set aid [file join $r a]
    $tv focus $aid
    $::ns\::_expand .t
    set kids [names [$tv children $aid]]
    destroy .t
    set kids
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {x.png}

test tkufiletree-1.5 {-files 0 shows directories only} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -files 0
    set tv [$::ns\::treeview .t]
    set rootid [lindex [$tv children ""] 0]
    set top [lsort [names [$tv children $rootid]]]
    destroy .t
    set top
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {a b}

test tkufiletree-1.6 {-showhidden includes dot entries} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -showhidden 1
    set tv [$::ns\::treeview .t]
    set rootid [lindex [$tv children ""] 0]
    set has [expr {".hidden" in [names [$tv children $rootid]]}]
    destroy .t
    set has
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 1

test tkufiletree-1.7 {-showhidden: dot entries once, also where "*" matches them (Windows)} \
    -constraints tk -setup {
    set r [mktree]
    # Emulate Windows glob: "*" also returns dot files. Since 0.3 the names
    # come from tuprovider::localNames, so the emulation goes there.
    proc ::tclutils::tuprovider::glob {args} {
        set res [::glob {*}$args]
        if {[lindex $args end] eq "*" && "hidden" ni $args} {
            lappend res {*}[::glob {*}[lrange $args 0 end-1] .*]
        }
        return $res
    }
} -body {
    $::ns\::widget .t -root $r -showhidden 1
    set tv [$::ns\::treeview .t]
    set rootid [lindex [$tv children ""] 0]
    set n [names [$tv children $rootid]]
    expr {".hidden" in $n && [llength $n] == [llength [lsort -unique $n]]}
} -cleanup {
    rename ::tclutils::tuprovider::glob {}
    catch {destroy .t}
    ::tcltest::removeDirectory ft
} -result 1

test tkufiletree-2.1 {activating a file fires -onactivate with its path} -constraints tk -setup {
    set r [mktree]
} -body {
    set ::acted ""
    $::ns\::widget .t -root $r -onactivate {apply {p {set ::acted $p}}}
    set tv [$::ns\::treeview .t]
    $tv selection set [file join $r m.png]
    $::ns\::_activate .t
    destroy .t
    string equal $::acted [file join $r m.png]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 1

test tkufiletree-2.2 {activating a directory does not fire -onactivate} -constraints tk -setup {
    set r [mktree]
} -body {
    set ::acted "untouched"
    $::ns\::widget .t -root $r -onactivate {apply {p {set ::acted $p}}}
    set tv [$::ns\::treeview .t]
    $tv selection set [file join $r a]
    $::ns\::_activate .t
    destroy .t
    set ::acted
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {untouched}

test tkufiletree-2.3 {selectedPath returns the selected full path} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r
    set tv [$::ns\::treeview .t]
    $tv selection set [file join $r n.txt]
    set p [$::ns\::selectedPath .t]
    destroy .t
    string equal $p [file join $r n.txt]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 1

test tkufiletree-2.4 {refresh re-reads the root from disk} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -filter {*.png}
    set tv [$::ns\::treeview .t]
    set rootid [lindex [$tv children ""] 0]
    set ch [open [file join $r added.png] w]; close $ch
    $::ns\::refresh .t
    set rootid [lindex [$tv children ""] 0]
    set has [expr {"added.png" in [names [$tv children $rootid]]}]
    destroy .t
    set has
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 1

test tkufiletree-3.1 {root returns the current root directory} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r
    set got [$::ns\::root .t]
    destroy .t
    string equal $got [file normalize $r]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 1

test tkufiletree-3.2 {reveal expands ancestors and selects a nested file} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r
    set deep [file join $r b c deep.png]
    set ok [$::ns\::reveal .t $deep]
    set sel [$::ns\::selectedPath .t]
    destroy .t
    list $ok [string equal $sel [file normalize $deep]]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {1 1}

test tkufiletree-3.3 {reveal of a path outside the root returns 0} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r
    set out [$::ns\::reveal .t [file join [file dirname $r] elsewhere.png]]
    destroy .t
    set out
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result 0

test tkufiletree-3.4 {reveal of a filtered-out file selects its folder and returns 0} -constraints tk -setup {
    set r [mktree]
    set ch [open [file join $r a noext] w]; close $ch  ;# no extension -> filtered out
} -body {
    $::ns\::widget .t -root $r -filter {*.png}
    set ok [$::ns\::reveal .t [file join $r a noext]]
    set sel [$::ns\::selectedPath .t]
    destroy .t
    list $ok [string equal $sel [file normalize [file join $r a]]]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {0 1}

test tkufiletree-3.5 {up re-roots to the parent and reveals the previous root} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root [file join $r a]
    $::ns\::up .t
    set newroot [$::ns\::root .t]
    set sel [$::ns\::selectedPath .t]
    destroy .t
    list [string equal $newroot [file normalize $r]] \
         [string equal $sel [file normalize [file join $r a]]]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {1 1}

test tkufiletree-3.6 {-isolatekeys drops the toplevel bindtag} -constraints tk -setup {
    set r [mktree]
} -body {
    $::ns\::widget .t -root $r -isolatekeys 1
    set bt [bindtags [$::ns\::treeview .t]]
    destroy .t
    list [expr {"." ni $bt}] [expr {"Treeview" in $bt}]
} -cleanup { catch {destroy .t}; ::tcltest::removeDirectory ft } -result {1 1}

# --- 0.2: -provider ---------------------------------------------------------
# A provider whose paths do not exist on the local disk. If the tree read the
# filesystem instead (as up to 0.1, where -provider was silently ignored), it
# would stay empty.
oo::class create FakeProv {
    variable tree
    constructor {} {
        set tree [dict create \
            / {{name virtdir path /virtdir type dir} {name top.txt path /top.txt type file}} \
            /virtdir {{name inner path /virtdir/inner type dir} {name a.txt path /virtdir/a.txt type file}} \
            /virtdir/inner {}]
    }
    method list {p} { return [dict get $tree $p] }
    method stat {p} {
        if {[dict exists $tree $p]} { return [list name [file tail $p] path $p type dir] }
        return [list name [file tail $p] path $p type file]
    }
}

test tkufiletree-9.1 {-provider: the tree lists the provider, not the local disk} \
        -constraints tk -setup {
    set fp [FakeProv new]
    ::tkutils::tkufiletree::widget .ftp -root / -provider $fp -files 1
    update
} -body {
    set tv [::tkutils::tkutree::treeview .ftp]
    set top [lmap id [$tv children [lindex [$tv children {}] 0]] {set id}]
    list [expr {"/virtdir" in $top}] [expr {"/top.txt" in $top}]
} -cleanup { destroy .ftp; $fp destroy } -result {1 1}

test tkufiletree-9.2 {-provider: opening a directory populates it through the provider} \
        -constraints tk -setup {
    set fp [FakeProv new]
    ::tkutils::tkufiletree::widget .ftp -root / -provider $fp -files 1
    update
} -body {
    set tv [::tkutils::tkutree::treeview .ftp]
    $tv focus /virtdir
    ::tkutils::tkufiletree::_expand .ftp
    lsort [$tv children /virtdir]
} -cleanup { destroy .ftp; $fp destroy } -result {/virtdir/a.txt /virtdir/inner}

test tkufiletree-9.3 {an unknown option is still rejected} -constraints tk -body {
    catch {::tkutils::tkufiletree::widget .ftp -provder x} m o
    dict get $o -errorcode
} -cleanup { catch {destroy .ftp} } -result {TKUTILS TKUFILETREE OPTION -provder}

testConstraint winFs  [expr {$::tcl_platform(platform) eq "windows"}]

test tkufiletree-1.8 {Windows: attribute rules for files and folders} -constraints {tk winFs} -setup {
    set r [::tcltest::makeDirectory ftattr]
    foreach {n attrs} {norm {} sys {-system 1} hid {-hidden 1} both {-hidden 1 -system 1}} {
        set f [file join $r $n.txt]; set fh [open $f w]; puts $fh x; close $fh
        set d [file join $r ${n}dir]; file mkdir $d
        if {[llength $attrs]} { file attributes $f {*}$attrs; file attributes $d {*}$attrs }
    }
    set fh [open [file join $r .dot.txt] w]; puts $fh x; close $fh
    proc kids {args} {
        $::ns\::widget .t -root $::r {*}$args
        set tv [$::ns\::treeview .t]
        set n [names [$tv children [lindex [$tv children ""] 0]]]
        destroy .t
        return $n
    }
} -body {
    list [kids] [kids -showhidden 1] [kids -showhidden 1 -showsystem 1]
} -cleanup {
    foreach f [::tclutils::tuprovider::localNames $r] { catch {file attributes $f -hidden 0 -system 0} }
    catch {destroy .t}
    ::tcltest::removeDirectory ftattr
} -result {{normdir sysdir .dot.txt norm.txt sys.txt} {hiddir normdir sysdir .dot.txt hid.txt norm.txt sys.txt} {bothdir hiddir normdir sysdir .dot.txt both.txt hid.txt norm.txt sys.txt}}

test tkufiletree-1.9 {with -provider the keys hidden and system decide, not the dot} -constraints tk -setup {
    oo::class create TreeProv {
        method list {d} {
            if {$d ne "/r"} { return {} }
            return [list \
                [dict create name .gitignore path /r/.gitignore type file hidden 0 system 0] \
                [dict create name geheim path /r/geheim type dir hidden 1 system 0] \
                [dict create name desktop.ini path /r/desktop.ini type file hidden 1 system 1] \
                [dict create name .ohne path /r/.ohne type file]]
        }
        method stat {p} { return [dict create name [file tail $p] path $p type dir] }
    }
    set p [TreeProv new]
    proc pkids {args} {
        $::ns\::widget .t -root /r -provider $::p {*}$args
        set tv [$::ns\::treeview .t]
        set n [names [$tv children [lindex [$tv children ""] 0]]]
        destroy .t
        return $n
    }
} -body {
    list [pkids] [pkids -showhidden 1] [pkids -showhidden 1 -showsystem 1]
} -cleanup {
    catch {destroy .t}
    $p destroy; TreeProv destroy
} -result {.gitignore {geheim .gitignore .ohne} {geheim .gitignore .ohne desktop.ini}}

cleanupTests
