package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set haveTk 1
if {[catch {package require Tk 8.6-}]} {
    set haveTk 0
}
testConstraint haveTk $haveTk

set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}


if {$haveTk} {
    package require tkutils::tkuhexedit
}

test tkuhexedit-1.1 {create widget and set data} -constraints haveTk -body {
    catch {destroy .h}
    set w [::tkutils::tkuhexedit::widget .h]
    ::tkutils::tkuhexedit::setData $w ABC
    string length [::tkutils::tkuhexedit::getData $w]
} -result 3

test tkuhexedit-1.2 {find text} -constraints haveTk -body {
    catch {destroy .h}
    set w [::tkutils::tkuhexedit::widget .h]
    ::tkutils::tkuhexedit::setData $w "Hello PDF"
    ::tkutils::tkuhexedit::findText $w PDF
} -result 6

test tkuhexedit-1.3 {find hex} -constraints haveTk -body {
    catch {destroy .h}
    set w [::tkutils::tkuhexedit::widget .h]
    ::tkutils::tkuhexedit::setData $w "PK\x03\x04demo"
    ::tkutils::tkuhexedit::findHex $w {50 4B 03 04}
} -result 0

test tkuhexedit-1.4 {patch hex length preserving} -constraints haveTk -body {
    catch {destroy .h}
    set w [::tkutils::tkuhexedit::widget .h]
    ::tkutils::tkuhexedit::setData $w ABCD
    ::tkutils::tkuhexedit::patchHex $w 1 {58 59}
    ::tkutils::tkuhexedit::getData $w
} -result AXYD

test tkuhexedit-1.5 {load and save file} -constraints haveTk -body {
    catch {destroy .h}
    set w [::tkutils::tkuhexedit::widget .h]
    set dir [makeDirectory hexedit]
    set in [file join $dir in.bin]
    set out [file join $dir out.bin]
    set ch [open $in wb]
    fconfigure $ch -translation binary -encoding iso8859-1
    puts -nonewline $ch ABC
    close $ch
    ::tkutils::tkuhexedit::loadFile $w $in
    ::tkutils::tkuhexedit::patchHex $w 1 {58}
    ::tkutils::tkuhexedit::saveFile $w $out
    set ch [open $out rb]
    fconfigure $ch -translation binary -encoding iso8859-1
    set data [read $ch]
    close $ch
    set data
} -result AXC

test tkuhexedit-9.1 {a failed save leaves the old file, no temp file, no channel} -constraints {haveTk} -setup {
    set f [makeFile PRECIOUS tkuhexedit-9.1.bin]
    catch {destroy .hxw}; set w [::tkutils::tkuhexedit::widget .hxw]
    ::tkutils::tkuhexedit::loadFile $w $f
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tkutils::tkuhexedit::saveFile $w $f}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tkuhexedit-9.1.bin
} -result {1 PRECIOUS 0 0}

cleanupTests
