package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
set haveEng [expr {$haveTk && ![catch {package require tclutils::tuical 0.1}]}]
testConstraint ical $haveEng
if {$haveEng} { package require tkutils::tkuical }

set ics "BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nUID:1\r\nSUMMARY:Meeting\r\nDTSTART;VALUE=DATE:20260101\r\nLOCATION:Room 1\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:2\r\nSUMMARY:Lunch\r\nDTSTART:20260102\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"

test tkuical-1.1 {loadText counts events and rows} -constraints ical -body {
    catch {destroy .c}
    set w [::tkutils::tkuical::widget .c]
    set n [::tkutils::tkuical::loadText $w $ics]
    set tv [::tkutils::tkuical::treeWidget $w]
    list $n [llength [$tv children {}]]
} -result {2 2}

test tkuical-1.2 {row text and values} -constraints ical -body {
    catch {destroy .c}
    set w [::tkutils::tkuical::widget .c]
    ::tkutils::tkuical::loadText $w $ics
    set tv [::tkutils::tkuical::treeWidget $w]
    set first [lindex [$tv children {}] 0]
    list [$tv item $first -text] [$tv item $first -values]
} -result {Meeting {20260101 {} {Room 1}}}

test tkuical-1.3 {events accessor + count} -constraints ical -body {
    catch {destroy .c}
    set w [::tkutils::tkuical::widget .c]
    ::tkutils::tkuical::loadText $w $ics
    list [::tkutils::tkuical::count $w] [llength [::tkutils::tkuical::events $w]]
} -result {2 2}

test tkuical-2.1 {setField updates summary and location} -constraints ical -body {
    catch {destroy .c}; set w [::tkutils::tkuical::widget .c]
    ::tkutils::tkuical::loadText $w $ics
    ::tkutils::tkuical::setField $w 0 summary "Standup"
    ::tkutils::tkuical::setField $w 0 location "Room X"
    set ev [lindex [::tkutils::tkuical::events $w] 0]
    list [::tclutils::tuical::property $ev SUMMARY] [::tclutils::tuical::property $ev LOCATION]
} -result {Standup {Room X}}

test tkuical-2.2 {addEvent} -constraints ical -body {
    catch {destroy .c}; set w [::tkutils::tkuical::widget .c]
    ::tkutils::tkuical::loadText $w $ics
    set idx [::tkutils::tkuical::addEvent $w "New Event"]
    list $idx [::tkutils::tkuical::count $w] \
         [::tclutils::tuical::property [lindex [::tkutils::tkuical::events $w] $idx] SUMMARY]
} -result {2 3 {New Event}}

test tkuical-2.3 {removeEvent} -constraints ical -body {
    catch {destroy .c}; set w [::tkutils::tkuical::widget .c]
    ::tkutils::tkuical::loadText $w $ics
    ::tkutils::tkuical::removeEvent $w 0
    ::tkutils::tkuical::count $w
} -result 1

test tkuical-2.4 {toText keeps calendar props and edits} -constraints ical -body {
    catch {destroy .c}; set w [::tkutils::tkuical::widget .c]
    set src "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//x//EN\r\nBEGIN:VEVENT\r\nSUMMARY:A\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
    ::tkutils::tkuical::loadText $w $src
    ::tkutils::tkuical::setField $w 0 summary "B"
    set cal [lindex [::tclutils::tuical::parse [::tkutils::tkuical::toText $w]] 0]
    list [::tclutils::tuical::property $cal VERSION] \
         [::tclutils::tuical::property [lindex [::tclutils::tuical::find $cal VEVENT] 0] SUMMARY]
} -result {2.0 B}

cleanupTests
