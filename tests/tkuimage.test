package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
if {$haveTk} { package require tkutils::tkuimage }
# Frozen 6x4 RGB PNG produced by tclutils::tupng -- fixtures need no Tk encoder.
# (top-left red, top-right green, bottom-left blue, bottom-right yellow)
set PNG6x4 [binary decode base64 {iVBORw0KGgoAAAANSUhEUgAAAAYAAAAECAIAAAAiZtkUAAAAHUlEQVR4nGP8zwAFjDAWEwMGYGRggMr+/8+IUxUA5swFBCSHa5EAAAAASUVORK5CYII=}]

test tkuimage-1.1 {fit contain} -constraints haveTk -body {
    lassign [::tkutils::tkuimage::fit 1920 1080 800 600 contain] w h s
    list $w $h [format %.3f $s]
} -result {800 450 0.417}
test tkuimage-1.2 {fit cover} -constraints haveTk -body {
    lassign [::tkutils::tkuimage::fit 1920 1080 800 600 cover] w h
    list $w $h
} -result {1066 600}
test tkuimage-1.3 {fit none} -constraints haveTk -body {
    ::tkutils::tkuimage::fit 100 50 999 999 none
} -result {100 50 1.0}
test tkuimage-1.4 {fit rejects zero size} -constraints haveTk -body {
    catch {::tkutils::tkuimage::fit 0 10 100 100} e o
    dict get $o -errorcode
} -result {TKUTILS TKIMAGE SIZE}

test tkuimage-2.1 {scale down via Tk fallback} -constraints haveTk -body {
    set src [image create photo -width 100 -height 100]
    set dst [::tkutils::tkuimage::scale $src 50 50]
    set r [list [image width $dst] [image height $dst]]
    image delete $src $dst; set r
} -result {50 50}
test tkuimage-2.2 {scale up via Tk fallback} -constraints haveTk -body {
    set src [image create photo -width 100 -height 100]
    set dst [::tkutils::tkuimage::scale $src 200 200]
    set r [list [image width $dst] [image height $dst]]
    image delete $src $dst; set r
} -result {200 200}
test tkuimage-2.3 {thumbnail keeps aspect} -constraints haveTk -body {
    set src [image create photo -width 200 -height 100]
    set dst [::tkutils::tkuimage::thumbnail $src 50]
    set r [list [image width $dst] [image height $dst]]
    image delete $src $dst; set r
} -result {50 25}

test tkuimage-3.1 {view widget builds and loads a real PNG} -constraints haveTk -setup {
    set tmp [file join [::tcltest::makeDirectory ti] s.png]
    set ch [open $tmp w]; fconfigure $ch -translation binary
    puts -nonewline $ch $PNG6x4; close $ch
} -body {
    catch {::destroy .v}
    set v [::tkutils::tkuimage::view .v]
    ::tkutils::tkuimage::openFile .v $tmp
    update idletasks
    set ok [list [winfo exists .v] [winfo exists .v.c] \
        [image width [::tkutils::tkuimage::getImage .v]] \
        [image height [::tkutils::tkuimage::getImage .v]]]
    ::destroy .v
    set ok
} -cleanup { ::tcltest::removeDirectory ti } -result {1 1 6 4}

test tkuimage-3.2 {Destroy cleans up state} -constraints haveTk -body {
    catch {::destroy .v2}
    set v [::tkutils::tkuimage::view .v2]
    ::destroy .v2
    update
    llength [array names ::tkutils::tkuimage::state .v2,*]
} -result 0

test tkuimage-2.4 {fromData builds a photo from PNG bytes} -constraints haveTk -body {
    set img [::tkutils::tkuimage::fromData $PNG6x4]
    set r [list [image width $img] [image height $img]]
    image delete $img; set r
} -result {6 4}

test tkuimage-4.1 {zoomLevel is 0 before an image is loaded} -constraints haveTk -body {
    catch {::destroy .vz}
    ::tkutils::tkuimage::view .vz
    set r [::tkutils::tkuimage::zoomLevel .vz]
    ::destroy .vz
    set r
} -result 0

test tkuimage-4.2 {zoom1 is 1.0 and zoomIn scales it (actual mode, exact)} -constraints haveTk -setup {
    set tmp [file join [::tcltest::makeDirectory tz] s.png]
    set ch [open $tmp w]; fconfigure $ch -translation binary
    puts -nonewline $ch $PNG6x4; close $ch
} -body {
    catch {::destroy .vz}
    ::tkutils::tkuimage::view .vz
    ::tkutils::tkuimage::openFile .vz $tmp
    ::tkutils::tkuimage::zoom1 .vz
    set a [::tkutils::tkuimage::zoomLevel .vz]
    ::tkutils::tkuimage::zoomIn .vz
    set b [::tkutils::tkuimage::zoomLevel .vz]
    ::destroy .vz
    list $a $b
} -cleanup { ::tcltest::removeDirectory tz } -result {1.0 1.25}

test tkuimage-4.3 {-onchange fires on redraw} -constraints haveTk -setup {
    set tmp [file join [::tcltest::makeDirectory tc] s.png]
    set ch [open $tmp w]; fconfigure $ch -translation binary
    puts -nonewline $ch $PNG6x4; close $ch
} -body {
    catch {::destroy .vc}
    set ::fired 0
    pack [::tkutils::tkuimage::view .vc -onchange {apply {{p} {incr ::fired}}}]
    wm geometry . 320x240 ; update ; update idletasks
    ::tkutils::tkuimage::openFile .vc $tmp ; update ; update idletasks
    ::tkutils::tkuimage::zoomIn .vc ; update
    set f $::fired
    ::destroy .vc
    expr {$f >= 1}
} -cleanup { ::tcltest::removeDirectory tc } -result 1

test tkuimage-4.4 {switching to a smaller image resizes disp (no leftovers)} -constraints haveTk -setup {
    set dir [::tcltest::makeDirectory tsw]
    set big [image create photo -width 60 -height 40]; $big put red -to 0 0 60 40
    $big write [file join $dir big.gif] -format gif; image delete $big
    set sml [image create photo -width 12 -height 8]; $sml put blue -to 0 0 12 8
    $sml write [file join $dir sml.gif] -format gif; image delete $sml
} -body {
    catch {::destroy .vsw}
    pack [::tkutils::tkuimage::view .vsw -fitmode actual]
    wm geometry . 220x200 ; update ; update idletasks
    ::tkutils::tkuimage::openFile .vsw [file join $dir big.gif]
    ::tkutils::tkuimage::zoom1 .vsw ; update
    ::tkutils::tkuimage::openFile .vsw [file join $dir sml.gif]
    ::tkutils::tkuimage::zoom1 .vsw ; update
    set disp $::tkutils::tkuimage::state(.vsw,disp)
    set r [list [image width $disp] [image height $disp]]
    ::destroy .vsw
    set r
} -cleanup { ::tcltest::removeDirectory tsw } -result {12 8}

test tkuimage-4.5 {first zoom continues from the fit scale, not full resolution} -constraints haveTk -setup {
    set dir [::tcltest::makeDirectory tzf]
    set big [image create photo -width 800 -height 600]; $big put red -to 0 0 40 40
    $big write [file join $dir big.gif] -format gif; image delete $big
} -body {
    catch {::destroy .vzf}
    pack [::tkutils::tkuimage::view .vzf -fitmode contain]
    wm geometry . 200x180 ; update ; update idletasks
    ::tkutils::tkuimage::openFile .vzf [file join $dir big.gif] ; update ; update idletasks
    set fit [::tkutils::tkuimage::zoomLevel .vzf]
    ::tkutils::tkuimage::zoomIn .vzf ; update
    set z [::tkutils::tkuimage::zoomLevel .vzf]
    ::destroy .vzf
    expr {$fit < 0.9 && $z < 1.0 && abs($z - $fit * 1.25) < 0.01}
} -cleanup { ::tcltest::removeDirectory tzf } -result 1

cleanupTests
