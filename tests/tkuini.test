package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
set haveEng [expr {$haveTk && ![catch {package require tclutils::tuini 0.2}]}]
testConstraint ini $haveEng
if {$haveEng} { package require tkutils::tkuini }

set ini "global1 = g1\n\[server\]\nhost = localhost\nport = 8080\n\[db\]\nname = test\n"

test tkuini-1.1 {loadText counts sections} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkuini::widget .i]
    set n [::tkutils::tkuini::loadText $w $ini]
    list $n [::tkutils::tkuini::sections $w]
} -result {3 {{} server db}}

test tkuini-1.2 {selectSection shows key/value rows} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::selectSection $w server
    set kv [::tkutils::tkuini::treeWidget $w]
    set rows [$kv children {}]
    set first [lindex $rows 0]
    list [llength $rows] [$kv item $first -text] [$kv item $first -values]
} -result {2 host localhost}

test tkuini-1.3 {currentSection} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::selectSection $w db
    ::tkutils::tkuini::currentSection $w
} -result db

test tkuini-1.4 {global section keys} -constraints ini -body {
    catch {destroy .i}
    set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::selectSection $w ""
    set kv [::tkutils::tkuini::treeWidget $w]
    set first [lindex [$kv children {}] 0]
    list [$kv item $first -text] [$kv item $first -values]
} -result {global1 g1}

test tkuini-2.1 {setKey adds/updates a value} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::setKey $w server timeout 30
    ::tclutils::tuini::get [::tkutils::tkuini::data $w] server timeout
} -result 30

test tkuini-2.2 {removeKey} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::removeKey $w server port
    ::tclutils::tuini::keys [::tkutils::tkuini::data $w] server
} -result host

test tkuini-2.3 {addSection / removeSection} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::addSection $w cache
    set s1 [::tkutils::tkuini::sections $w]
    ::tkutils::tkuini::removeSection $w db
    list $s1 [::tkutils::tkuini::sections $w]
} -result {{{} server db cache} {{} server cache}}

test tkuini-2.4 {toText reflects edits} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w $ini
    ::tkutils::tkuini::setKey $w server host 9.9.9.9
    ::tclutils::tuini::get [::tclutils::tuini::parse [::tkutils::tkuini::toText $w]] server host
} -result 9.9.9.9

proc _bytes {f} { set ch [open $f rb]; set b [read $ch]; close $ch; return $b }
test tkuini-3.1 {save and loadFile in UTF-8 whatever the system encoding} -constraints ini -setup {
    ::set f [makeFile {} tkuini-3.1.ini]
    ::set enc [encoding system]
} -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w "\[user\]\nname = J\u00f6rg\n"
    encoding system iso8859-1
    ::tkutils::tkuini::save $w $f
    ::set b [_bytes $f]
    catch {destroy .i2}; set w2 [::tkutils::tkuini::widget .i2]
    ::tkutils::tkuini::loadFile $w2 $f
    encoding system $enc
    list [expr {[string first [encoding convertto utf-8 "J\u00f6rg"] $b] >= 0}] \
         [string match "*J\u00f6rg*" [::tkutils::tkuini::toText $w2]]
} -cleanup {
    encoding system $enc
    removeFile tkuini-3.1.ini
    catch {destroy .i .i2}
} -result {1 1}

test tkuini-4.1 {setKey: what INI cannot hold is an error, data unchanged} -constraints ini -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w "\[S\]\na = 1\n"
    list [catch {::tkutils::tkuini::setKey $w S k "x\ny"}] $::errorCode \
        [::tkutils::tkuini::toText $w]
} -cleanup {
    catch {destroy .i}
} -result [list 1 {TCLUTILS TUINI VALUE} "\[S\]\na=1"]

test tkuini-4.2 {edit bar: message instead of background error, key trimmed} -constraints ini -setup {
    rename ::tk_messageBox ::_tkuini_mb
    proc ::tk_messageBox {args} { lappend ::_mb [dict get $args -message]; return ok }
    set ::_mb {}
} -body {
    catch {destroy .i}; set w [::tkutils::tkuini::widget .i]
    ::tkutils::tkuini::loadText $w "\[S\]\na = 1\n"
    ::tkutils::tkuini::selectSection $w S
    set ::tkutils::tkuini::state($w,ekey) " b "
    set ::tkutils::tkuini::state($w,eval) "2"
    ::tkutils::tkuini::_uiSet $w
    set ::tkutils::tkuini::state($w,ekey) "c"
    set ::tkutils::tkuini::state($w,eval) "x\ny"
    ::tkutils::tkuini::_uiSet $w
    list [::tkutils::tkuini::toText $w] [llength $::_mb]
} -cleanup {
    catch {destroy .i}
    rename ::tk_messageBox {}
    rename ::_tkuini_mb ::tk_messageBox
} -result [list "\[S\]\na=1\nb=2" 1]

cleanupTests
