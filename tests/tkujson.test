package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk

set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkujson }

set sample {{"name":"Greg","tags":["a","b"],"meta":{"age":30}}}

test tkujson-1.1 {setJson returns root type} -constraints haveTk -body {
    catch {destroy .j}
    set w [::tkutils::tkujson::widget .j]
    ::tkutils::tkujson::setJson $w $sample
} -result object

test tkujson-1.2 {getTree is typed} -constraints haveTk -body {
    catch {destroy .j}
    set w [::tkutils::tkujson::widget .j]
    ::tkutils::tkujson::setJson $w $sample
    lindex [::tkutils::tkujson::getTree $w] 0
} -result object

test tkujson-1.3 {root object has three members} -constraints haveTk -body {
    catch {destroy .j}
    set w [::tkutils::tkujson::widget .j]
    ::tkutils::tkujson::setJson $w $sample
    set root [lindex [$w.tv children {}] 0]
    llength [$w.tv children $root]
} -result 3

test tkujson-1.4 {array member has two elements} -constraints haveTk -body {
    catch {destroy .j}
    set w [::tkutils::tkujson::widget .j]
    ::tkutils::tkujson::setJson $w $sample
    set root [lindex [$w.tv children {}] 0]
    set tags [lindex [$w.tv children $root] 1]
    llength [$w.tv children $tags]
} -result 2

test tkujson-1.5 {scalar root} -constraints haveTk -body {
    catch {destroy .j}
    set w [::tkutils::tkujson::widget .j]
    ::tkutils::tkujson::setJson $w {42}
} -result number

cleanupTests
