package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
set haveEng [expr {$haveTk && ![catch {package require tclutils::tuldif 0.1}]}]
testConstraint ldif $haveEng
if {$haveEng} { package require tkutils::tkuldif }

set ldif "dn: cn=Alice,dc=ex\ncn: Alice\nsn: Smith\nmail: alice@ex.com\nmail: a@ex.com\n\ndn: cn=Bob,dc=ex\ncn: Bob\n"

test tkuldif-1.1 {loadText counts entries and top nodes} -constraints ldif -body {
    catch {destroy .l}
    set w [::tkutils::tkuldif::widget .l]
    set n [::tkutils::tkuldif::loadText $w $ldif]
    set tv [::tkutils::tkuldif::treeWidget $w]
    list $n [llength [$tv children {}]]
} -result {2 2}

test tkuldif-1.2 {entry node labelled with dn} -constraints ldif -body {
    catch {destroy .l}
    set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    set tv [::tkutils::tkuldif::treeWidget $w]
    $tv item [lindex [$tv children {}] 0] -text
} -result {cn=Alice,dc=ex}

test tkuldif-1.3 {all attribute rows shown (incl dn)} -constraints ldif -body {
    catch {destroy .l}
    set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    set tv [::tkutils::tkuldif::treeWidget $w]
    set first [lindex [$tv children {}] 0]
    llength [$tv children $first]
} -result 5

test tkuldif-1.4 {entries accessor} -constraints ldif -body {
    catch {destroy .l}
    set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    ::tkutils::tkuldif::count $w
} -result 2

test tkuldif-2.1 {setAttr changes a value} -constraints ldif -body {
    catch {destroy .l}; set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    ::tkutils::tkuldif::setAttr $w 0 1 cn Alicia
    ::tclutils::tuldif::get [lindex [::tkutils::tkuldif::entries $w] 0] cn
} -result Alicia

test tkuldif-2.2 {addAttr / removeAttr} -constraints ldif -body {
    catch {destroy .l}; set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    ::tkutils::tkuldif::addAttr $w 0 title Engineer
    set v1 [::tclutils::tuldif::get [lindex [::tkutils::tkuldif::entries $w] 0] title]
    ::tkutils::tkuldif::removeAttr $w 0 [expr {[llength [lindex [::tkutils::tkuldif::entries $w] 0]] - 1}]
    set v2 [::tclutils::tuldif::get [lindex [::tkutils::tkuldif::entries $w] 0] title]
    list $v1 $v2
} -result {Engineer {}}

test tkuldif-2.3 {addEntry / removeEntry} -constraints ldif -body {
    catch {destroy .l}; set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    set idx [::tkutils::tkuldif::addEntry $w "cn=Carl,dc=ex"]
    set n1 [::tkutils::tkuldif::count $w]
    ::tkutils::tkuldif::removeEntry $w $idx
    list $idx $n1 [::tkutils::tkuldif::count $w]
} -result {2 3 2}

test tkuldif-2.4 {toText round-trips} -constraints ldif -body {
    catch {destroy .l}; set w [::tkutils::tkuldif::widget .l]
    ::tkutils::tkuldif::loadText $w $ldif
    ::tkutils::tkuldif::setAttr $w 0 1 cn Alicia
    set e [::tclutils::tuldif::parse [::tkutils::tkuldif::toText $w]]
    ::tclutils::tuldif::get [lindex $e 0] cn
} -result Alicia

cleanupTests
