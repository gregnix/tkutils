package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
catch {tcl::tm::path add $tmDir}
if {[info exists ::env(TKUTILS_TM)]} { catch {tcl::tm::path add $::env(TKUTILS_TM)} }
if {$haveTk} { package require tkutils::tkumarquee }

set ns ::tkutils::tkumarquee

proc mkcanvas {} {
    catch {destroy .c}
    pack [canvas .c -width 300 -height 200 -bg white]
    update
}

# --- selection lifecycle ----------------------------------------------------

test tkumarquee-1.1 {drag reports the selected region} -constraints haveTk -body {
    mkcanvas
    set ::sel ""
    $::ns\::enable .c -onselect {apply {{c x1 y1 x2 y2} {set ::sel [list $x1 $y1 $x2 $y2]}}}
    event generate .c <ButtonPress-1> -x 20 -y 30; update
    event generate .c <B1-Motion> -x 120 -y 90; update
    event generate .c <ButtonRelease-1> -x 120 -y 90; update
    set ::sel
} -result {20.0 30.0 120.0 90.0}

test tkumarquee-1.2 {onstart fires at press with start coords} -constraints haveTk -body {
    mkcanvas
    set ::st ""
    $::ns\::enable .c -onstart {apply {{c x y} {set ::st [list $x $y]}}}
    event generate .c <ButtonPress-1> -x 40 -y 50; update
    event generate .c <ButtonRelease-1> -x 41 -y 51; update
    set ::st
} -result {40.0 50.0}

test tkumarquee-1.3 {a reversed drag is normalised x1<x2 y1<y2} -constraints haveTk -body {
    mkcanvas
    set ::sel ""
    $::ns\::enable .c -onselect {apply {{c x1 y1 x2 y2} {set ::sel [list $x1 $y1 $x2 $y2]}}}
    event generate .c <ButtonPress-1> -x 150 -y 150; update
    event generate .c <B1-Motion> -x 50 -y 50; update
    event generate .c <ButtonRelease-1> -x 50 -y 50; update
    set ::sel
} -result {50.0 50.0 150.0 150.0}

test tkumarquee-1.4 {a click (sub-minsize) does not fire} -constraints haveTk -body {
    mkcanvas
    set ::sel none
    $::ns\::enable .c -onselect {apply {{c x1 y1 x2 y2} {set ::sel fired}}}
    event generate .c <ButtonPress-1> -x 80 -y 80; update
    event generate .c <ButtonRelease-1> -x 81 -y 81; update
    set ::sel
} -result none

test tkumarquee-1.5 {region accessor returns the last region} -constraints haveTk -body {
    mkcanvas
    $::ns\::enable .c
    event generate .c <ButtonPress-1> -x 10 -y 10; update
    event generate .c <B1-Motion> -x 60 -y 40; update
    event generate .c <ButtonRelease-1> -x 60 -y 40; update
    $::ns\::region .c
} -result {10.0 10.0 60.0 40.0}

test tkumarquee-1.6 {rubber-band item is removed after release by default} -constraints haveTk -body {
    mkcanvas
    $::ns\::enable .c
    event generate .c <ButtonPress-1> -x 10 -y 10; update
    event generate .c <B1-Motion> -x 60 -y 40; update
    event generate .c <ButtonRelease-1> -x 60 -y 40; update
    .c find withtag all
} -result {}

test tkumarquee-1.7 {keep 1 leaves the rectangle on the canvas} -constraints haveTk -body {
    mkcanvas
    $::ns\::enable .c -keep 1
    event generate .c <ButtonPress-1> -x 10 -y 10; update
    event generate .c <B1-Motion> -x 60 -y 40; update
    event generate .c <ButtonRelease-1> -x 60 -y 40; update
    expr {[llength [.c find withtag all]] == 1}
} -result 1

test tkumarquee-1.8 {fill + stipple translucent overlay does not error} -constraints haveTk -body {
    mkcanvas
    $::ns\::enable .c -keep 1 -fill "#1565c0" -stipple gray12
    event generate .c <ButtonPress-1> -x 10 -y 10; update
    event generate .c <B1-Motion> -x 60 -y 40; update
    event generate .c <ButtonRelease-1> -x 60 -y 40; update
    expr {[llength [.c find withtag all]] == 1}
} -result 1

# --- errors / lifecycle -----------------------------------------------------

test tkumarquee-2.1 {enable on unknown widget errors} -constraints haveTk -body {
    catch {$::ns\::enable .nope} m o
    dict get $o -errorcode
} -result {TKUTILS TKUMARQUEE NOWIDGET}

test tkumarquee-2.2 {unknown option errors} -constraints haveTk -body {
    mkcanvas
    catch {$::ns\::enable .c -bogus 1} m o
    dict get $o -errorcode
} -result {TKUTILS TKUMARQUEE OPTION}

test tkumarquee-2.3 {disable removes the press binding} -constraints haveTk -body {
    mkcanvas
    $::ns\::enable .c
    $::ns\::disable .c
    bind .c <ButtonPress-1>
} -result {}

test tkumarquee-2.4 {Destroy clears per-widget state} -constraints haveTk -body {
    mkcanvas
    $::ns\::enable .c
    destroy .c
    update
    info exists ${::ns}::state(.c,onselect)
} -result 0

cleanupTests
