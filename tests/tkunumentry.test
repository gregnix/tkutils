package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
tcl::tm::path add [file normalize [file join [file dirname [file normalize [info script]]] .. lib tm]]
if {$haveTk} { package require tkutils::tkunumentry }

test tkunumentry-1.1 {empty initially} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n]
    ::tkutils::tkunumentry::getValue $w
} -result ""
test tkunumentry-1.2 {setValue formats to decimals} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n -decimals 2]
    ::tkutils::tkunumentry::setValue $w 3.14159
} -result 3.14
test tkunumentry-1.3 {integer mode} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n]
    ::tkutils::tkunumentry::setValue $w 42
} -result 42
test tkunumentry-1.4 {clamp to min/max} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n -min 0 -max 10]
    list [::tkutils::tkunumentry::setValue $w 99] [::tkutils::tkunumentry::setValue $w -5]
} -result {10 0}
test tkunumentry-1.5 {non-number errors} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n]
    catch {::tkutils::tkunumentry::setValue $w abc} e o; dict get $o -errorcode
} -result {TKUTILS TKNUMENTRY VALUE}
test tkunumentry-2.1 {validate accepts partials, rejects bad} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n -decimals 2]
    list [::tkutils::tkunumentry::_validate $w "3.1"] \
         [::tkutils::tkunumentry::_validate $w "3.111"] \
         [::tkutils::tkunumentry::_validate $w "-"] \
         [::tkutils::tkunumentry::_validate $w "abc"]
} -result {1 0 1 0}
test tkunumentry-2.2 {commit fires command with value} -constraints haveTk -body {
    catch {destroy .n}; set ::got ""
    set w [::tkutils::tkunumentry::widget .n -decimals 2 -command {set ::got}]
    ::tkutils::tkunumentry::setValue $w 7
    ::tkutils::tkunumentry::_commit $w
    set ::got
} -result 7.00
test tkunumentry-2.3 {clear empties} -constraints haveTk -body {
    catch {destroy .n}; set w [::tkutils::tkunumentry::widget .n]
    ::tkutils::tkunumentry::setValue $w 5
    ::tkutils::tkunumentry::clear $w
    ::tkutils::tkunumentry::getValue $w
} -result ""
cleanupTests
