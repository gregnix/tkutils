package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set haveTk [expr {![catch {package require Tk}]}]
if {$haveTk} { catch {wm withdraw .} }
testConstraint tk $haveTk

if {$haveTk} {
    set here [file dirname [file normalize [info script]]]
    set tmDir [file normalize [file join $here .. lib tm]]
    catch {tcl::tm::path add $tmDir}
    if {[info exists ::env(TKUTILS_TM)]} { catch {tcl::tm::path add $::env(TKUTILS_TM)} }
    package require tkutils::tkupath
}
set ns ::tkutils::tkupath

test tkupath-1.1 {widget creates} -constraints tk -body {
    ${ns}::widget .p1
    set r [winfo exists .p1]
    destroy .p1
    set r
} -result 1

test tkupath-1.2 {setPath / getPath round-trip} -constraints tk -body {
    ${ns}::widget .p2
    ${ns}::setPath .p2 /home/greg/docs
    set r [${ns}::getPath .p2]
    destroy .p2
    set r
} -result /home/greg/docs

test tkupath-1.3 {a path renders one clickable segment per component} -constraints tk -body {
    ${ns}::widget .p3
    ${ns}::setPath .p3 /home/greg/docs
    update
    # count the child buttons/labels that make up the breadcrumb
    set segs [llength [winfo children .p3]]
    destroy .p3
    expr {$segs >= 3}
} -result 1

test tkupath-1.4 {clicking a segment fires -onnavigate with that path} -constraints tk -body {
    set ::nav ""
    ${ns}::widget .p4 -onnavigate {apply {p {set ::nav $p}}}
    ${ns}::setPath .p4 /home/greg/docs
    update
    # find a child that carries an invoke command mentioning /home, and invoke it
    foreach c [winfo children .p4] {
        if {![catch {$c cget -command} cmd] && $cmd ne ""} {
            if {[string match *home* $cmd] || [string match *greg* $cmd]} { $c invoke ; break }
        }
    }
    set r [expr {$::nav ne ""}]
    destroy .p4
    set r
} -result 1

test tkupath-1.5 {setting a new path replaces the old segments} -constraints tk -body {
    ${ns}::widget .p5
    ${ns}::setPath .p5 /a/b/c
    ${ns}::setPath .p5 /x
    set r [${ns}::getPath .p5]
    destroy .p5
    set r
} -result /x

# Windows paths (0.3): the segments navigate to real paths, not "/S:/..."
proc tkupathTargets {w} {
    set out {}
    foreach c [winfo children $w] {
        if {[catch {$c cget -command} cmd] || $cmd eq ""} continue
        lappend out [list [$c cget -text] [lindex $cmd end]]
    }
    return $out
}

test tkupath-2.1 {drive path: segments and targets} -constraints tk -body {
    ${ns}::widget .p21
    ${ns}::setPath .p21 S:/gregor/daten
    set r [tkupathTargets .p21]
    destroy .p21
    set r
} -result {{S: S:/} {gregor S:/gregor} {daten S:/gregor/daten}}

test tkupath-2.2 {clicking a drive segment navigates on that drive} -constraints tk -body {
    set ::nav ""
    ${ns}::widget .p22 -onnavigate {apply {p {set ::nav $p}}}
    ${ns}::setPath .p22 S:/gregor/daten
    .p22.seg1 invoke
    set r [list $::nav [${ns}::getPath .p22]]
    destroy .p22
    set r
} -result {S:/gregor S:/gregor}

test tkupath-2.3 {UNC path and backslashes} -constraints tk -body {
    ${ns}::widget .p23
    ${ns}::setPath .p23 {\\srv\share\x}
    set r [tkupathTargets .p23]
    destroy .p23
    set r
} -result {{//srv/share //srv/share/} {x //srv/share/x}}

test tkupath-2.4 {Unix paths unchanged, root label kept} -constraints tk -body {
    ${ns}::widget .p24 -rootlabel Wurzel
    ${ns}::setPath .p24 /home/greg
    set r [tkupathTargets .p24]
    destroy .p24
    set r
} -result {{Wurzel /} {home /home} {greg /home/greg}}

test tkupath-2.5 {drive root alone} -constraints tk -body {
    ${ns}::widget .p25
    ${ns}::setPath .p25 C:/
    set r [tkupathTargets .p25]
    destroy .p25
    set r
} -result {{C: C:/}}

cleanupTests
