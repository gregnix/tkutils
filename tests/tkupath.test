package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set haveTk [expr {![catch {package require Tk}]}]
if {$haveTk} { catch {wm withdraw .} }
testConstraint tk $haveTk

if {$haveTk} {
    set here [file dirname [file normalize [info script]]]
    set tmDir [file normalize [file join $here .. lib tm]]
    catch {tcl::tm::path add $tmDir}
    if {[info exists ::env(TKUTILS_TM)]} { catch {tcl::tm::path add $::env(TKUTILS_TM)} }
    package require tkutils::tkupath
}
set ns ::tkutils::tkupath

test tkupath-1.1 {widget creates} -constraints tk -body {
    ${ns}::widget .p1
    set r [winfo exists .p1]
    destroy .p1
    set r
} -result 1

test tkupath-1.2 {setPath / getPath round-trip} -constraints tk -body {
    ${ns}::widget .p2
    ${ns}::setPath .p2 /home/greg/docs
    set r [${ns}::getPath .p2]
    destroy .p2
    set r
} -result /home/greg/docs

test tkupath-1.3 {a path renders one clickable segment per component} -constraints tk -body {
    ${ns}::widget .p3
    ${ns}::setPath .p3 /home/greg/docs
    update
    # count the child buttons/labels that make up the breadcrumb
    set segs [llength [winfo children .p3]]
    destroy .p3
    expr {$segs >= 3}
} -result 1

test tkupath-1.4 {clicking a segment fires -onnavigate with that path} -constraints tk -body {
    set ::nav ""
    ${ns}::widget .p4 -onnavigate {apply {p {set ::nav $p}}}
    ${ns}::setPath .p4 /home/greg/docs
    update
    # find a child that carries an invoke command mentioning /home, and invoke it
    foreach c [winfo children .p4] {
        if {![catch {$c cget -command} cmd] && $cmd ne ""} {
            if {[string match *home* $cmd] || [string match *greg* $cmd]} { $c invoke ; break }
        }
    }
    set r [expr {$::nav ne ""}]
    destroy .p4
    set r
} -result 1

test tkupath-1.5 {setting a new path replaces the old segments} -constraints tk -body {
    ${ns}::widget .p5
    ${ns}::setPath .p5 /a/b/c
    ${ns}::setPath .p5 /x
    set r [${ns}::getPath .p5]
    destroy .p5
    set r
} -result /x

cleanupTests
