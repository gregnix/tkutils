# Tests for the tkutils::tkurender render core. Self-contained: models are built
# via the core API (no app01 files, no external .tkd fixtures).
package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} { package require tkutils::tkurender }

variable seq 0

proc ::firstType {t} {
    foreach id [dict keys $::tkurender::D(nodes)] {
        if {[::tkurender::nodeType $id] eq $t} { return $id }
    }
    return ""
}

test tkurender-1.1 {catalogue distinguishes containers from leaves} -constraints haveTk -body {
    expr {[::tkurender::isContainer frame] && ![::tkurender::isContainer label]}
} -result 1

test tkurender-1.2 {addNode + node accessors round-trip} -constraints haveTk -body {
    ::tkurender::newModel
    set e [::tkurender::addNode entry $::tkurender::D(root)]
    ::tkurender::setName $e myEntry
    ::tkurender::setOpt  $e width 22
    list [::tkurender::nodeType $e] [::tkurender::nodeName $e] [::tkurender::nodeOpt $e width]
} -result {entry myEntry 22}

test tkurender-1.3 {serialize/deserialize preserves names} -constraints haveTk -body {
    ::tkurender::newModel
    ::tkurender::setName [::tkurender::addNode entry $::tkurender::D(root)] foo
    set spec [::tkurender::serialize]
    ::tkurender::newModel
    ::tkurender::deserialize $spec
    ::tkurender::nodeName [firstType entry]
} -result foo

test tkurender-1.4 {deserialize backfills a missing newer opt} -constraints haveTk -body {
    ::tkurender::newModel
    ::tkurender::addNode treeview $::tkurender::D(root)
    set spec [string map {{items {}} {}} [::tkurender::serialize]]
    ::tkurender::deserialize $spec
    ::tkurender::nodeOpt [firstType treeview] items
} -result {}

test tkurender-2.1 {renderChildren creates real Tk widgets} -constraints haveTk -body {
    ::tkurender::newModel
    set f [::tkurender::addNode frame $::tkurender::D(root)]
    set l [::tkurender::addNode label $f]; ::tkurender::setOpt $l text Hi
    set e [::tkurender::addNode entry $f]
    set top [toplevel .rt[incr ::seq]]
    set ::tkurender::D(embedded) 1
    array unset ::tkurender::D wpath,*
    ::tkurender::renderChildren $::tkurender::D(root) $top $top
    set ok 1
    foreach id [list $f $l $e] {
        if {![info exists ::tkurender::D(wpath,$id)]
            || ![winfo exists $::tkurender::D(wpath,$id)]} { set ok 0 }
    }
    destroy $top
    set ok
} -result 1

cleanupTests
