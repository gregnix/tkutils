package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
testConstraint haveTk $haveTk

set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk} {
    package require tkutils::tkusysinfo 0.1
    package require tclutils::tujson
}

proc tops {tv} { lmap n [$tv children {}] {$tv item $n -text} }

test tkusysinfo-1.1 {widget collects at once and shows the sections} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkusysinfo::widget .s -sections {os cpu memory}]
    set t [tops $w.tv]
    list [lindex $t 0] [expr {"Operating system" in $t}] [expr {"Memory" in $t}] \
         [expr {"Screen" in $t}] [winfo exists $w.bar.refresh]
} -result {Platform 1 1 1 1}

test tkusysinfo-1.2 {-autoload 0: empty until refresh} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkusysinfo::widget .s -autoload 0 -buttons 0 -sections os]
    set before [list [::tkutils::tkusysinfo::data $w] [llength [$w.tv children {}]]]
    ::tkutils::tkusysinfo::refresh $w
    list $before [dict exists [::tkutils::tkusysinfo::data $w] os] [winfo exists $w.bar]
} -result {{{} 0} 1 0}

test tkusysinfo-1.3 {screen data from Tk} -constraints haveTk -body {
    set s [::tkutils::tkusysinfo::screen .]
    list [lsort [dict keys $s]] [regexp {^\d+x\d+$} [dict get $s pixels]]
} -result {{depth dpi millimeters pixels scaling windowing} 1}

test tkusysinfo-1.4 {report and JSON include the screen} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkusysinfo::widget .s -sections {os memory}]
    set r [::tkutils::tkusysinfo::report $w -anonymize 1]
    set j [::tkutils::tkusysinfo::json $w]
    list [string match "*--- Screen (Tk) ---*Pixels: *" $r] [string match *Host:\ <host>* $r] \
         [::tclutils::tujson::validate $j] \
         [dict exists [::tclutils::tujson::parse $j] screen pixels]
} -result {1 1 1 1}

test tkusysinfo-1.5 {save as text and JSON} -constraints haveTk -body {
    catch {destroy .s}
    set w [::tkutils::tkusysinfo::widget .s -sections os]
    set d [makeDirectory sysinfo]
    ::tkutils::tkusysinfo::save $w [file join $d a.txt]
    ::tkutils::tkusysinfo::save $w [file join $d a.json] -format json
    set fh [open [file join $d a.json]]; set j [read $fh]; close $fh
    list [file size [file join $d a.txt]] [::tclutils::tujson::validate $j]
} -match glob -result {[1-9]* 1}

test tkusysinfo-1.6 {errors: option, format} -constraints haveTk -body {
    catch {destroy .s}
    list [catch {::tkutils::tkusysinfo::widget .s -bogus 1} e1] [lrange $::errorCode 0 3] \
         [catch {destroy .s; ::tkutils::tkusysinfo::widget .s -sections os} w] \
         [catch {::tkutils::tkusysinfo::save .s x.txt -format pdf} e2] $e2
} -result {1 {TKUTILS TKUSYSINFO OPTION -bogus} 0 1 {bad format "pdf": must be text or json}}

cleanupTests
