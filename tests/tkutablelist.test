package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set haveTbl 0
if {$haveTk} {
    if {![catch {package require tablelist_tile}] || ![catch {package require Tablelist}]} {
        set haveTbl 1
    }
}
testConstraint tablelist [expr {$haveTk && $haveTbl}]
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk && $haveTbl} {
    package require tkutils::tkutablelist
    catch {package require tclutils::tunotes 0.1}
}

test tkutablelist-1.1 {widget builds; columns titles} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age City}]
    ::tkutils::tkutablelist::columns $w
} -result {Name Age City}

test tkutablelist-1.2 {insert + size + rows} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age}]
    ::tkutils::tkutablelist::insert $w {Alice 30}
    ::tkutils::tkutablelist::insert $w {Bob 25}
    list [::tkutils::tkutablelist::size $w] [::tkutils::tkutablelist::rows $w]
} -result {2 {{Alice 30} {Bob 25}}}

test tkutablelist-1.3 {setRows replaces all} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::insert $w {x y}
    ::tkutils::tkutablelist::setRows $w {{1 2} {3 4}}
    ::tkutils::tkutablelist::rows $w
} -result {{1 2} {3 4}}

test tkutablelist-1.4 {loadCsv sets columns from header and rows} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t]
    set csv "name,age\nBob,25\nAlice,30\n"
    set n [::tkutils::tkutablelist::loadCsv $w $csv]
    list $n [::tkutils::tkutablelist::columns $w] [::tkutils::tkutablelist::rows $w]
} -result {2 {name age} {{Bob 25} {Alice 30}}}

test tkutablelist-1.5 {sortBy reorders ascending} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age}]
    ::tkutils::tkutablelist::setRows $w {{Bob 25} {Alice 30}}
    ::tkutils::tkutablelist::sortBy $w 0 -increasing
    ::tkutils::tkutablelist::rows $w
} -result {{Alice 30} {Bob 25}}

test tkutablelist-1.6 {titlecolumns option frozen} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B C} -titlecolumns 1]
    [::tkutils::tkutablelist::tableWidget $w] cget -titlecolumns
} -result 1

test tkutablelist-2.1 {cellText / setCell} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age}]
    ::tkutils::tkutablelist::setRows $w {{Alice 30} {Bob 25}}
    ::tkutils::tkutablelist::setCell $w 0 1 99
    list [::tkutils::tkutablelist::cellText $w 0 1] [::tkutils::tkutablelist::getRow $w 0]
} -result {99 {Alice 99}}

test tkutablelist-2.2 {setRow / deleteRow} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::setRows $w {{1 2} {3 4} {5 6}}
    ::tkutils::tkutablelist::setRow $w 1 {x y}
    ::tkutils::tkutablelist::deleteRow $w 0
    list [::tkutils::tkutablelist::size $w] [::tkutils::tkutablelist::rows $w]
} -result {2 {{x y} {5 6}}}

test tkutablelist-2.3 {selection helpers} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::setRows $w {{a 1} {b 2} {c 3}}
    ::tkutils::tkutablelist::selectRows $w {0 2}
    list [::tkutils::tkutablelist::selection $w] [::tkutils::tkutablelist::selectedRows $w]
} -result {{0 2} {{a 1} {c 3}}}

test tkutablelist-2.4 {configureColumn integer sort} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age}]
    ::tkutils::tkutablelist::setRows $w {{a 30} {b 7} {c 100}}
    ::tkutils::tkutablelist::configureColumn $w 1 -sortmode integer
    ::tkutils::tkutablelist::sortBy $w 1 -increasing
    ::tkutils::tkutablelist::rows $w
} -result {{b 7} {a 30} {c 100}}

test tkutablelist-2.5 {-editable makes columns editable} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B} -editable 1]
    set tbl [::tkutils::tkutablelist::tableWidget $w]
    list [$tbl columncget 0 -editable] [$tbl columncget 1 -editable]
} -result {1 1}

test tkutablelist-2.6 {fromNotes shows a tunotes store} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t]
    set st [dict create]
    set r [::tclutils::tunotes::create st "Root" "x" {work}]
    ::tclutils::tunotes::create st "Child" "y" {} $r
    ::tkutils::tkutablelist::fromNotes $w $st
    list [::tkutils::tkutablelist::size $w]          [::tkutils::tkutablelist::columns $w]          [lindex [::tkutils::tkutablelist::rows $w] 1 1]
} -result {2 {Title Parent Tags} Root}

test tkutablelist-3.1 {toCsv round-trips through tucsv} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age}]
    ::tkutils::tkutablelist::setRows $w {{Alice 30} {Bob 25}}
    ::tclutils::tucsv::parse [::tkutils::tkutablelist::toCsv $w]
} -result {{Name Age} {Alice 30} {Bob 25}}

test tkutablelist-3.2 {saveCsv writes a file that loadCsv reads back} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name Age}]
    ::tkutils::tkutablelist::setRows $w {{Alice 30} {Bob 25}}
    set f [file join [makeDirectory tlcsv] t.csv]
    ::tkutils::tkutablelist::saveCsv $w $f
    set ch [open $f r]; set txt [read $ch]; close $ch
    catch {destroy .t2}
    set w2 [::tkutils::tkutablelist::widget .t2]
    ::tkutils::tkutablelist::loadCsv $w2 $txt
    list [::tkutils::tkutablelist::columns $w2] [::tkutils::tkutablelist::rows $w2]
} -result {{Name Age} {{Alice 30} {Bob 25}}}

test tkutablelist-3.3 {declarative column spec applies sortmode and align} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Name {Age -sortmode integer -align right}}]
    set tbl [::tkutils::tkutablelist::tableWidget $w]
    list [::tkutils::tkutablelist::columns $w]          [$tbl columncget 1 -sortmode] [$tbl columncget 1 -align]
} -result {{Name Age} integer right}

test tkutablelist-3.4 {editEnd hook transforms; default passes through} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}         -editendcommand {apply {{p r c t} {return [string toupper $t]}}}]
    set tbl [::tkutils::tkutablelist::tableWidget $w]
    set a [::tkutils::tkutablelist::_editEnd $w $tbl 0 0 "hello"]
    ::tkutils::tkutablelist::editEndCommand $w ""
    set b [::tkutils::tkutablelist::_editEnd $w $tbl 0 0 "hello"]
    list $a $b
} -result {HELLO hello}

test tkutablelist-3.5 {multi-word column titles are preserved} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {{Full Name} Age}]
    ::tkutils::tkutablelist::columns $w
} -result {{Full Name} Age}

test tkutablelist-4.1 {selectcommand fires with the selected row} -constraints tablelist -body {
    catch {destroy .t}
    set ::selRow -99
    set w [::tkutils::tkutablelist::widget .t -columns {A B} \
        -selectcommand {apply {{p r} {set ::selRow $r}}}]
    ::tkutils::tkutablelist::setRows $w {{1 a} {2 b} {3 c}}
    $w.tbl selection clear 0 end
    $w.tbl selection set 1
    event generate $w.tbl <<TablelistSelect>>
    set ::selRow
} -result 1

test tkutablelist-4.2 {selectcommand yields -1 on empty selection} -constraints tablelist -body {
    catch {destroy .t}
    set ::selRow -99
    set w [::tkutils::tkutablelist::widget .t -columns {A B} \
        -selectcommand {apply {{p r} {set ::selRow $r}}}]
    ::tkutils::tkutablelist::setRows $w {{1 a} {2 b}}
    $w.tbl selection clear 0 end
    event generate $w.tbl <<TablelistSelect>>
    set ::selRow
} -result -1

test tkutablelist-4.3 {no selectcommand by default does not error} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::setRows $w {{1 a}}
    $w.tbl selection set 0
    event generate $w.tbl <<TablelistSelect>>
    set w
} -result .t

test tkutablelist-4.4 {doublecommand fires with the clicked row} -constraints tablelist -body {
    catch {destroy .t}
    set ::dblRow -99
    set w [::tkutils::tkutablelist::widget .t -columns {A B} \
        -doublecommand {apply {{p r} {set ::dblRow $r}}}]
    ::tkutils::tkutablelist::setRows $w {{1 a} {2 b} {3 c}}
    pack $w; update idletasks
    set body [$w.tbl bodypath]
    # find a body y mapping to data row 2, then drive the bound handler directly
    # (event generate cannot synthesise a Double modifier).
    set targetY 4
    for {set yy 0} {$yy < [winfo height $body]} {incr yy 2} {
        lassign [tablelist::convEventFields $body 5 $yy] tt xx cy
        if {[$w.tbl containing $cy] == 2} { set targetY $yy; break }
    }
    ::tkutils::tkutablelist::_dblClick $w $body 5 $targetY
    set ::dblRow
} -result 2

test tkutablelist-4.7 {double-click handler is bound on the body tag} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    string match *_dblClick* [bind [$w.tbl bodytag] <Double-1>]
} -result 1

test tkutablelist-4.8 {doublecommand does not fire off a data row} -constraints tablelist -body {
    catch {destroy .t}
    set ::dblRow -99
    set w [::tkutils::tkutablelist::widget .t -columns {A B} \
        -doublecommand {apply {{p r} {set ::dblRow $r}}}]
    ::tkutils::tkutablelist::setRows $w {{1 a}}
    pack $w; update idletasks
    set body [$w.tbl bodypath]
    # y far below the last row -> containing returns -1 -> no fire
    ::tkutils::tkutablelist::_dblClick $w $body 5 100000
    set ::dblRow
} -result -99

test tkutablelist-4.5 {runtime setters set and read the callbacks} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::selectCommand $w {sel cmd}
    ::tkutils::tkutablelist::doubleCommand $w {dbl cmd}
    list [::tkutils::tkutablelist::selectCommand $w] [::tkutils::tkutablelist::doubleCommand $w]
} -result {{sel cmd} {dbl cmd}}

test tkutablelist-4.6 {unknown widget option errors with code} -constraints tablelist -body {
    catch {destroy .t}
    catch {::tkutils::tkutablelist::widget .t -columns {A B} -bogus 1} m o
    dict get $o -errorcode
} -result {TKUTILS TKUTABLELIST OPTION}

# --- part B: row/cell formatting ---

test tkutablelist-5.1 {configureRow sets foreground} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::setRows $w {{1 a} {2 b}}
    ::tkutils::tkutablelist::configureRow $w 0 -foreground gray
    [::tkutils::tkutablelist::tableWidget $w] rowcget 0 -foreground
} -result gray

test tkutablelist-5.2 {configureCell sets background} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::setRows $w {{1 a}}
    ::tkutils::tkutablelist::configureCell $w 0,0 -background yellow
    [::tkutils::tkutablelist::tableWidget $w] cellcget 0,0 -background
} -result yellow

test tkutablelist-5.3 {configureRow returns its target ("end")} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::setRows $w {{1 a}}
    ::tkutils::tkutablelist::configureRow $w end -foreground red
} -result end

# --- part C: hierarchy (parent/child rows) ---

test tkutablelist-6.1 {insertChild returns a key and nests} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    set p [::tkutils::tkutablelist::insertChild $w root {AB x}]
    set c [::tkutils::tkutablelist::insertChild $w $p {LF y}]
    expr {$p ne "" && $c ne "" && $p ne $c}
} -result 1

test tkutablelist-6.2 {a child key can be coloured via configureRow} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    set p [::tkutils::tkutablelist::insertChild $w root {AB x}]
    ::tkutils::tkutablelist::configureRow $w $p -foreground darkblue
    [::tkutils::tkutablelist::tableWidget $w] rowcget $p -foreground
} -result darkblue

test tkutablelist-6.3 {expand/collapse (all and by row) do not error} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    set p [::tkutils::tkutablelist::insertChild $w root {AB x}]
    ::tkutils::tkutablelist::insertChild $w $p {LF y}
    ::tkutils::tkutablelist::expand $w
    ::tkutils::tkutablelist::collapse $w
    ::tkutils::tkutablelist::expand $w $p
    ::tkutils::tkutablelist::collapse $w $p
    expr 1
} -result 1

test tkutablelist-7.1 {-footer 1 creates a footer widget} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B C} -footer 1]
    expr {[::tkutils::tkutablelist::footerWidget $w] eq "$w.foot" && [winfo exists $w.foot]}
} -result 1

test tkutablelist-7.2 {footerWidget empty without -footer} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B}]
    ::tkutils::tkutablelist::footerWidget $w
} -result {}

test tkutablelist-7.3 {footer clones column count and titlecolumns} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B C D} -titlecolumns 2 -footer 1]
    set f [::tkutils::tkutablelist::footerWidget $w]
    list [$f columncount] [$f cget -titlecolumns]
} -result {4 2}

test tkutablelist-7.4 {footerSet sets footer cells} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B C} -footer 1]
    ::tkutils::tkutablelist::footerSet $w {Sum: {} 42}
    [::tkutils::tkutablelist::footerWidget $w] get 0
} -result {Sum: {} 42}

test tkutablelist-7.5 {footerSum totals a column, German-aware (demo parity)} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {Article Price} -footer 1]
    ::tkutils::tkutablelist::setRows $w {{Apple 1,50} {Pear 2,00} {Cherry 4,20}}
    ::tkutils::tkutablelist::footerSum $w -columns {1} -label Sum: -format %.2f
    [::tkutils::tkutablelist::footerWidget $w] get 0
} -result {Sum: 7.70}

test tkutablelist-7.6 {footer clones hidden columns} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B C} -footer 1]
    ::tkutils::tkutablelist::configureColumn $w 2 -hide 1
    ::tkutils::tkutablelist::_footerSync $w
    [::tkutils::tkutablelist::footerWidget $w] columncget 2 -hide
} -result 1

test tkutablelist-7.7 {table xscrollcommand mirrors footer (coupling wired)} -constraints tablelist -body {
    catch {destroy .t}
    set w [::tkutils::tkutablelist::widget .t -columns {A B} -footer 1]
    string match *_xscroll* [[::tkutils::tkutablelist::tableWidget $w] cget -xscrollcommand]
} -result 1

cleanupTests
