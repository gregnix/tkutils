package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
# tclutils: $env(TCLUTILS_TM), otherwise a sibling tclutils* checkout
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    foreach _c [lsort -decreasing [glob -nocomplain -type d [file join \
            [file dirname [file dirname $here]] tclutils* lib tm]]] {
        tcl::tm::path add $_c
        break
    }
}
testConstraint hasTk  [expr {![catch {package require Tk}]}]
testConstraint hasTbl [expr {![catch {package require tablelist_tile}]}]
if {[testConstraint hasTbl]} { package require tkutils::tkutlclip }
proc mkTbl {} {
    catch {destroy .t}
    tablelist::tablelist .t -columns {12 A left 8 N right}
    .t insert end {Apple 3}
    .t insert end {"Pear, x" 5}
    return .t
}
test tkutlclip-1.1 {asText tsv} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlclip::asText .t {0 1} -format tsv
} -result "Apple\t3\nPear, x\t5"
test tkutlclip-1.2 {asText csv quotes comma} -constraints {hasTk hasTbl} -body {
    mkTbl
    string match {*"Pear, x"*} [::tkutils::tkutlclip::asText .t {0 1} -format csv]
} -result 1
test tkutlclip-1.3 {csv with -separator ;} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlclip::asText .t {0 1} -format csv -separator ";"
} -result "Apple;3\nPear, x;5"
test tkutlclip-1.4 {bad separator} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlclip::asText .t {0} -separator ";;"
} -returnCodes error -match glob -result {separator must be one character}
test tkutlclip-2.1 {copyAll skips hidden rows} -constraints {hasTk hasTbl} -body {
    mkTbl
    .t insert end {Plum 7}
    .t rowconfigure 1 -hide 1
    list [::tkutils::tkutlclip::copyAll .t] [clipboard get]
} -result [list 2 "Apple\t3\nPlum\t7"]
test tkutlclip-2.2 {installBindings: Ctrl+C gives our format, not Tablelist's TSV} \
        -constraints {hasTk hasTbl} -body {
    mkTbl
    pack .t; update
    ::tkutils::tkutlclip::installBindings .t -format csv -separator ";"
    .t selection set 0 1
    focus -force [.t bodypath]; update
    clipboard clear; clipboard append XXX
    event generate [.t bodypath] <<Copy>>
    update
    clipboard get
} -cleanup { pack forget .t } -result "Apple;3\nPear, x;5"
test tkutlclip-2.3 {installBindings rejects bad options at once} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlclip::installBindings .t -format xls
} -returnCodes error -result {format must be tsv or csv}
test tkutlclip-2.4 {copySelection checks options with an empty selection} -constraints {hasTk hasTbl} -body {
    catch {destroy .t}
    tablelist::tablelist .t -columns {6 A left}
    .t insert end {x}
    list [catch {::tkutils::tkutlclip::copySelection .t -separator ab} e] $e
} -result {1 {separator must be one character}}
test tkutlclip-9.1 {csv is the same line as tucsv::text, which toCsv uses} -constraints {hasTk hasTbl} -body {
    catch {destroy .t}
    tablelist::tablelist .t -columns {8 A left 8 B left 8 C left}
    set rows [list [list "a,b" "say \"x\"" "two\nlines"] [list p {} r]]
    foreach r $rows { .t insert end $r }
    list [expr {[::tkutils::tkutlclip::asText .t {0 1} -format csv] eq [::tclutils::tucsv::text $rows]}] \
         [expr {[::tkutils::tkutlclip::asText .t {0 1} -format csv -separator ";"] eq [::tclutils::tucsv::text $rows -delimiter ";"]}]
} -cleanup {
    destroy .t
} -result {1 1}

cleanupTests
