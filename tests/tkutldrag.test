package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
# tclutils: $env(TCLUTILS_TM), otherwise a sibling tclutils* checkout
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    foreach _c [lsort -decreasing [glob -nocomplain -type d [file join \
            [file dirname [file dirname $here]] tclutils* lib tm]]] {
        tcl::tm::path add $_c
        break
    }
}
testConstraint hasTk  [expr {![catch {package require Tk}]}]
testConstraint hasTbl [expr {![catch {package require tablelist_tile}]}]
if {[testConstraint hasTbl]} { package require tkutils::tkutldrag 0.1 }
proc mkTbl {} {
    catch {destroy .t}
    tablelist::tablelist .t -columns {10 Name left} -treecolumn 0 -selectmode browse
    foreach {id n} {a Anna b Bert c Cora} {
        set k [.t insertchild root end [list $n]]
        .t rowconfigure $k -name $id
    }
    return .t
}
test tkutldrag-1.1 {enable sets movablerows and a usable select mode} -constraints {hasTk hasTbl} -body {
    mkTbl
    list [::tkutils::tkutldrag::enable .t] [.t cget -movablerows]
} -result {single 1}
test tkutldrag-1.2 {extended becomes multiple; disable} -constraints {hasTk hasTbl} -body {
    mkTbl; .t configure -selectmode extended
    set m [::tkutils::tkutldrag::enable .t]
    ::tkutils::tkutldrag::disable .t
    list $m [.t cget -movablerows]
} -result {multiple 0}
test tkutldrag-1.3 {callback gets the row id after a move} -constraints {hasTk hasTbl} -body {
    mkTbl
    set ::got {}
    ::tkutils::tkutldrag::enable .t -command {lappend ::got}
    .t move [.t getfullkeys 2] root 0
    event generate .t <<TablelistRowMoved>> -data [list [.t getfullkeys 0] root 0]
    list [lrange $::got 1 end] [::tkutils::tkutldrag::order .t]
} -result {{c root 0} {c a b}}
test tkutldrag-1.4 {-samelevel: no new parent, only siblings} -constraints {hasTk hasTbl} -body {
    mkTbl
    set k [.t insertchild [.t getfullkeys 0] end {Kind}]
    ::tkutils::tkutldrag::enable .t
    set ac [.t cget -acceptchildcommand]
    set ad [.t cget -acceptdropcommand]
    # rows: 0 Anna, 1 Kind (child of Anna), 2 Bert, 3 Cora
    list [{*}$ac .t 0 2] [{*}$ad .t 2 3] [{*}$ad .t 1 3] [{*}$ad .t [.t size] 3] [{*}$ad .t [.t size] 1]
} -result {0 1 0 1 0}
test tkutldrag-1.5 {unknown option} -constraints {hasTk hasTbl} -body {
    mkTbl
    catch {::tkutils::tkutldrag::enable .t -x 1} e
    set e
} -result {unknown option "-x": must be -command, -samelevel, -acceptchild or -acceptdrop}
cleanupTests
