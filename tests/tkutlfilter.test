package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
# tclutils: $env(TCLUTILS_TM), otherwise a sibling tclutils* checkout
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    foreach _c [lsort -decreasing [glob -nocomplain -type d [file join \
            [file dirname [file dirname $here]] tclutils* lib tm]]] {
        tcl::tm::path add $_c
        break
    }
}
testConstraint hasTk  [expr {![catch {package require Tk}]}]
testConstraint hasTbl [expr {![catch {package require tablelist_tile}]}]
if {[testConstraint hasTbl]} { package require tkutils::tkutlfilter 0.1 }
proc mkTbl {} {
    catch {destroy .t}
    tablelist::tablelist .t -columns {10 Name left 10 City left}
    .t insertlist end {{Anna Berlin} {Bert Bonn} {Cora Berlin} {Dirk Essen}}
    return .t
}
proc vis {} { lmap r [.t get 0 end -viewable] {lindex $r 0} }
test tkutlfilter-1.1 {filter hides non-matching rows} -constraints {hasTk hasTbl} -body {
    mkTbl
    list [::tkutils::tkutlfilter::filter .t berlin] [vis] [.t size] \
        [::tkutils::tkutlfilter::query .t]
} -result {2 {Anna Cora} 4 berlin}
test tkutlfilter-1.2 {clear and empty query show all again} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlfilter::filter .t berlin
    set a [::tkutils::tkutlfilter::filter .t ""]
    ::tkutils::tkutlfilter::filter .t bonn
    ::tkutils::tkutlfilter::clear .t
    list $a [vis]
} -result {4 {Anna Bert Cora Dirk}}
test tkutlfilter-1.3 {rows hidden by the application stay hidden} -constraints {hasTk hasTbl} -body {
    mkTbl
    .t rowconfigure 0 -hide 1
    set n [::tkutils::tkutlfilter::filter .t berlin]
    ::tkutils::tkutlfilter::clear .t
    list $n [vis]
} -result {1 {Bert Cora Dirk}}
test tkutlfilter-1.4 {-columns, -mode glob, -nocase 0} -constraints {hasTk hasTbl} -body {
    mkTbl
    list [::tkutils::tkutlfilter::filter .t B* -mode glob -columns 0] \
         [::tkutils::tkutlfilter::filter .t b* -mode glob -nocase 0]
} -result {1 0}
test tkutlfilter-1.5 {-command predicate} -constraints {hasTk hasTbl} -body {
    mkTbl
    proc ::longName {tbl key row} { expr {[string length [lindex $row 1]] > 4} }
    list [::tkutils::tkutlfilter::filter .t "" -command ::longName] [vis]
} -result {3 {Anna Cora Dirk}}
test tkutlfilter-1.6 {tree: ancestors of a match stay visible} -constraints {hasTk hasTbl} -body {
    catch {destroy .t}
    tablelist::tablelist .t -columns {10 Name left} -treecolumn 0
    set a [.t insertchild root end Obst]
    .t insertchildlist $a end {Apfel Birne}
    set b [.t insertchild root end Gemuese]
    .t insertchildlist $b end {Karotte}
    list [::tkutils::tkutlfilter::filter .t apfel] [lmap r [.t get 0 end -viewable] {lindex $r 0}]
} -result {1 {Obst Apfel}}
test tkutlfilter-1.7 {errors} -constraints {hasTk hasTbl} -body {
    mkTbl
    list [catch {::tkutils::tkutlfilter::filter .t x -mode fuzzy} e1] $e1 \
         [catch {::tkutils::tkutlfilter::filter .t ( -mode regexp} e2] [lindex $::errorCode 2] \
         [catch {::tkutils::tkutlfilter::filter .t x -bogus 1}]
} -result {1 {bad mode "fuzzy": must be substring, exact, glob or regexp} 1 REGEXP 1}
test tkutlfilter-1.8 {later filters after the delay and sends an event} -constraints {hasTk hasTbl} -body {
    mkTbl
    set ::fired 0
    bind .t <<TkutlFilterApplied>> {set ::fired 1}
    ::tkutils::tkutlfilter::later .t 20 a
    ::tkutils::tkutlfilter::later .t 20 essen
    vwait ::fired
    vis
} -result {Dirk}
test tkutlfilter-1.9 {-where: per-column AND by title, index or name} -constraints {hasTk hasTbl} -body {
    mkTbl
    .t columnconfigure 1 -name city
    list [::tkutils::tkutlfilter::filter .t "" -where {City berlin Name c}] [vis] \
         [::tkutils::tkutlfilter::filter .t "" -where {city b 0 {}}] \
         [::tkutils::tkutlfilter::filter .t a -where {1 essen}] \
         [catch {::tkutils::tkutlfilter::filter .t "" -where {Zip 1}} e] $e
} -result {1 Cora 3 0 1 {unknown column "Zip"}}
test tkutlfilter-9.1 {a pending "later" dies with its table} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlfilter::later .t 30 berlin
    destroy .t
    mkTbl
    after 80 {set ::wf 1}; vwait ::wf
    vis
} -result {Anna Bert Cora Dirk}

cleanupTests
