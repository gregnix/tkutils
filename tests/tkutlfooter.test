package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
catch {tcl::tm::path add [file normalize [file join $here .. .. tclutils lib tm]]}
testConstraint hasTk  [expr {![catch {package require Tk}]}]
testConstraint hasTbl [expr {![catch {package require tablelist}]}]
if {[testConstraint hasTbl]} { package require tkutils::tkutlfooter }
proc mkPair {} {
    catch {destroy .t}; catch {destroy .f}
    tablelist::tablelist .t -columns {12 A left 8 N right 12 P right}
    .t insert end {a 3 1,50}; .t insert end {b 5 2,00}
    .t insert end {c 12 4,20}; .t insert end {d 7 3,10}
    tablelist::tablelist .f -showlabels 0 -height 1 -columns {12 {} left 8 {} right 12 {} right}
    ::tkutils::tkutlfooter::attach .t .f
}
test tkutlfooter-1.1 {autosum} -constraints {hasTk hasTbl} -body {
    mkPair
    ::tkutils::tkutlfooter::autosum .t .f -columns {1} -label S -format %g
    .f get 0
} -result {S 27 {}}
test tkutlfooter-2.1 {autoagg avg/max} -constraints {hasTk hasTbl} -body {
    mkPair
    ::tkutils::tkutlfooter::autoagg .t .f -columns {1 max 2 avg} -label X -format %g
    .f get 0
} -result {X 12 2.7}
test tkutlfooter-2.2 {autoagg count} -constraints {hasTk hasTbl} -body {
    mkPair
    ::tkutils::tkutlfooter::autoagg .t .f -columns {2 countnum} -label C
    lindex [.f get 0] 2
} -result 4
test tkutlfooter-3.1 {attach chains a pre-existing -xscrollcommand instead of replacing it} -constraints {hasTk hasTbl} -body {
    catch {destroy .t}; catch {destroy .f}
    set ::origCalled ""
    proc ::origRec {first last} { set ::origCalled [list $first $last] }
    tablelist::tablelist .t -columns {12 A left 8 N right} -xscrollcommand [list ::origRec]
    .t insert end {a 3}
    tablelist::tablelist .f -showlabels 0 -height 1 -columns {12 {} left 8 {} right}
    ::tkutils::tkutlfooter::attach .t .f
    # invoke the (now chained) xscrollcommand the way tablelist would
    uplevel #0 [list {*}[.t cget -xscrollcommand] 0.3 0.6]
    set ::origCalled
} -result {0.3 0.6}

test tkutlfooter-3.2 {attach clones -titlecolumns onto the footer} -constraints {hasTk hasTbl} -body {
    catch {destroy .t}; catch {destroy .f}
    tablelist::tablelist .t -columns {12 A left 8 B right 8 C right} -titlecolumns 2
    tablelist::tablelist .f -showlabels 0 -height 1 -columns {}
    ::tkutils::tkutlfooter::attach .t .f
    .f cget -titlecolumns
} -result 2

test tkutlfooter-3.3 {update clones hidden columns onto the footer} -constraints {hasTk hasTbl} -body {
    catch {destroy .t}; catch {destroy .f}
    tablelist::tablelist .t -columns {12 A left 8 B right 8 C right}
    tablelist::tablelist .f -showlabels 0 -height 1 -columns {}
    ::tkutils::tkutlfooter::attach .t .f
    .t columnconfigure 2 -hide 1
    ::tkutils::tkutlfooter::update .t .f
    .f columncget 2 -hide
} -result 1

cleanupTests
