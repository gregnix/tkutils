package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
# tclutils: $env(TCLUTILS_TM), otherwise a sibling tclutils* checkout
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    foreach _c [lsort -decreasing [glob -nocomplain -type d [file join \
            [file dirname [file dirname $here]] tclutils* lib tm]]] {
        tcl::tm::path add $_c
        break
    }
}
testConstraint hasTk  [expr {![catch {package require Tk}]}]
testConstraint hasTbl [expr {![catch {package require tablelist_tile}]}]
if {[testConstraint hasTbl]} { package require tkutils::tkutlstate }
proc mkTbl {} {
    catch {destroy .t}
    tablelist::tablelist .t -columns {10 A left 10 B right 10 C left}
    .t insert end {1 2 3}; .t insert end {4 5 6}
    return .t
}
test tkutlstate-1.1 {save/restore widths+hide+sort} -constraints {hasTk hasTbl} -body {
    mkTbl
    .t columnconfigure 0 -width 20; .t columnconfigure 2 -hide 1
    .t sortbycolumn 1 -decreasing
    set s [::tkutils::tkutlstate::save .t]
    .t columnconfigure 0 -width 5; .t columnconfigure 2 -hide 0; .t sortbycolumn 0 -increasing
    ::tkutils::tkutlstate::restore .t $s
    list [.t columncget 0 -width] [.t columncget 2 -hide] [.t sortcolumn] [.t sortorder]
} -result {20 1 1 decreasing}
test tkutlstate-2.1 {restore rejects junk} -constraints {hasTk hasTbl} -body {
    mkTbl
    catch {::tkutils::tkutlstate::restore .t {not a state}} e
    set e
} -match glob -result {*not a tkutlstate dict*}
test tkutlstate-3.1 {saveVia/restoreVia round-trip via injected array storage} -constraints {hasTk hasTbl} -body {
    mkTbl
    array set ::store {}
    proc ::setS {key val} { set ::store($key) $val }
    proc ::getS {key}     { return [expr {[info exists ::store($key)] ? $::store($key) : ""}] }
    .t columnconfigure 0 -width 17; .t sortbycolumn 2 -decreasing
    ::tkutils::tkutlstate::saveVia .t ov [list ::setS]
    .t columnconfigure 0 -width 4; .t sortbycolumn 0 -increasing
    set ok [::tkutils::tkutlstate::restoreVia .t ov [list ::getS]]
    list $ok [.t columncget 0 -width] [.t sortcolumn] [.t sortorder]
} -result {1 17 2 decreasing}

test tkutlstate-3.2 {restoreVia on a missing key returns 0 and applies nothing} -constraints {hasTk hasTbl} -body {
    mkTbl
    proc ::getEmpty {key} { return "" }
    ::tkutils::tkutlstate::restoreVia .t nope [list ::getEmpty]
} -result 0

test tkutlstate-3.3 {autosave registers a binding that persists (debounced)} -constraints {hasTk hasTbl} -body {
    mkTbl
    set ::auto ""
    proc ::recA {key val} { set ::auto [list $key $val] }
    ::tkutils::tkutlstate::autosave .t mykey [list ::recA] -delay 20
    # tablelist fires <<TablelistColumnResized>> on a real resize; run the
    # registered script directly to exercise the chain deterministically.
    set scr [bind .t <<TablelistColumnResized>>]
    .t columnconfigure 0 -width 23
    uplevel #0 $scr
    after 90 {set ::wait 1}; vwait ::wait
    list [llength $::auto] [lindex $::auto 0] \
         [dict get [lindex $::auto 1] ncols]
} -result {2 mykey 3}

test tkutlstate-3.4 {cancelAutosave stops further persistence} -constraints {hasTk hasTbl} -body {
    mkTbl
    set ::auto ""
    proc ::recA {key val} { set ::auto [list $key $val] }
    ::tkutils::tkutlstate::autosave .t k [list ::recA] -delay 20
    set scr [bind .t <<TablelistColumnResized>>]
    ::tkutils::tkutlstate::cancelAutosave .t
    uplevel #0 $scr
    after 90 {set ::wait2 1}; vwait ::wait2
    set ::auto
} -result {}

proc mkNamed {} {
    catch {destroy .t}
    tablelist::tablelist .t -columns {10 A left 10 B right 10 C left}
    foreach c {0 1 2} n {a b c} { .t columnconfigure $c -name $n }
    .t insert end {x 2 p}; .t insert end {y 1 q}; .t insert end {x 1 r}
    return .t
}
proc layout {} {
    list [lmap c {0 1 2} {.t columncget $c -name}] \
         [.t columncget b -width] [.t columncget c -hide] \
         [lmap c [.t sortcolumnlist] {.t columncget $c -name}] [.t sortorderlist]
}
test tkutlstate-4.1 {moved columns: order, width and hide follow the column name} \
        -constraints {hasTk hasTbl} -body {
    mkNamed
    .t movecolumn c 0
    .t columnconfigure b -width -120
    .t columnconfigure c -hide 1
    .t sortbycolumnlist {a b} {increasing decreasing}
    set s [::tkutils::tkutlstate::save .t]
    mkNamed
    ::tkutils::tkutlstate::restore .t $s
    layout
} -result {{c a b} -120 1 {a b} {increasing decreasing}}
test tkutlstate-4.2 {unknown and new columns are tolerated} -constraints {hasTk hasTbl} -body {
    mkNamed
    .t movecolumn b 0
    set s [::tkutils::tkutlstate::save .t]
    catch {destroy .t}
    tablelist::tablelist .t -columns {10 A left 10 B right 10 D left}
    foreach c {0 1 2} n {a b d} { .t columnconfigure $c -name $n }
    ::tkutils::tkutlstate::restore .t $s
    lmap c {0 1 2} {.t columncget $c -name}
} -result {b a d}
test tkutlstate-4.3 {version 1 states (0.3) are still applied} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlstate::restore .t {version 1 ncols 3 columns {{width 20 hide 0} {width 10 hide 0} {width 10 hide 1}} sortcolumn 1 sortorder decreasing}
    list [.t columncget 0 -width] [.t columncget 2 -hide] [.t sortcolumn] [.t sortorder]
} -result {20 1 1 decreasing}
test tkutlstate-4.4 {autosave also reacts to sorting} -constraints {hasTk hasTbl} -body {
    mkTbl
    ::tkutils::tkutlstate::autosave .t k [list ::recA] -delay 10
    expr {[bind .t <<TablelistColumnSorted>>] ne ""}
} -result 1

test tkutlstate-5.1 {a failed autosave is reported: event, -onerror, lastError} -constraints {hasTk hasTbl} -body {
    mkTbl
    set ::seen {}
    proc ::badSet {key val} { error "disk full" }
    bind .t <<TkutlStateSaveFailed>> {lappend ::seen event %d}
    ::tkutils::tkutlstate::autosave .t k [list ::badSet] -delay 10 \
        -onerror [list apply {{tbl msg} {lappend ::seen cb $tbl $msg}}]
    uplevel #0 [bind .t <<TablelistColumnResized>>]
    after 60 {set ::wait5 1}; vwait ::wait5
    list $::seen [::tkutils::tkutlstate::lastError .t]
} -result {{event {disk full} cb .t {disk full}} {disk full}}

test tkutlstate-9.1 {a failed save leaves the old file, no temp file, no channel} -constraints {hasTk hasTbl} -setup {
    set f [makeFile PRECIOUS tkutlstate-9.1.state]
    mkTbl
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tkutils::tkutlstate::saveToFile .t $f}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tkutlstate-9.1.state
} -result {1 PRECIOUS 0 0}

cleanupTests
