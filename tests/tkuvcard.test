package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
set haveEng [expr {$haveTk && ![catch {package require tclutils::tuvcard 0.1}]}]
testConstraint vcard $haveEng
if {$haveEng} { package require tkutils::tkuvcard }

set vcf "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Alice Smith\r\nN:Smith;Alice;;;\r\nEMAIL;TYPE=work:alice@ex.com\r\nEMAIL;TYPE=home:a@home.com\r\nTEL;TYPE=cell:123\r\nEND:VCARD\r\nBEGIN:VCARD\r\nFN:Bob\r\nEND:VCARD\r\n"

test tkuvcard-1.1 {loadText counts cards and nodes} -constraints vcard -body {
    catch {destroy .v}
    set w [::tkutils::tkuvcard::widget .v]
    set n [::tkutils::tkuvcard::loadText $w $vcf]
    set tv [::tkutils::tkuvcard::treeWidget $w]
    list $n [llength [$tv children {}]]
} -result {2 2}

test tkuvcard-1.2 {card node labelled with FN} -constraints vcard -body {
    catch {destroy .v}
    set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    set tv [::tkutils::tkuvcard::treeWidget $w]
    $tv item [lindex [$tv children {}] 0] -text
} -result {Alice Smith}

test tkuvcard-1.3 {all properties shown as children} -constraints vcard -body {
    catch {destroy .v}
    set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    set tv [::tkutils::tkuvcard::treeWidget $w]
    set first [lindex [$tv children {}] 0]
    llength [$tv children $first]
} -result 6

test tkuvcard-1.4 {EMAIL row shows value and TYPE hint} -constraints vcard -body {
    catch {destroy .v}
    set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    set tv [::tkutils::tkuvcard::treeWidget $w]
    set first [lindex [$tv children {}] 0]
    set found ""
    foreach c [$tv children $first] {
        if {[$tv item $c -text] eq "EMAIL"} { set found [$tv item $c -values]; break }
    }
    set found
} -result {alice@ex.com work}

test tkuvcard-1.5 {cards accessor} -constraints vcard -body {
    catch {destroy .v}
    set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    ::tkutils::tkuvcard::count $w
} -result 2

test tkuvcard-2.1 {addCard grows list and FN shows} -constraints vcard -body {
    catch {destroy .v}; set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    set idx [::tkutils::tkuvcard::addCard $w "Carol"]
    list [::tkutils::tkuvcard::count $w] $idx \
         [::tclutils::tuvcard::fullName [lindex [::tkutils::tkuvcard::cards $w] $idx]]
} -result {3 2 Carol}

test tkuvcard-2.2 {addProperty / setProperty / removeProperty} -constraints vcard -body {
    catch {destroy .v}; set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    ::tkutils::tkuvcard::addProperty $w 1 EMAIL bob@x.com work
    set v1 [::tclutils::tuvcard::property [lindex [::tkutils::tkuvcard::cards $w] 1] EMAIL]
    ::tkutils::tkuvcard::setProperty $w 1 1 EMAIL bob2@x.com home
    set v2 [::tclutils::tuvcard::property [lindex [::tkutils::tkuvcard::cards $w] 1] EMAIL]
    ::tkutils::tkuvcard::removeProperty $w 1 1
    list $v1 $v2 [::tclutils::tuvcard::names [lindex [::tkutils::tkuvcard::cards $w] 1]]
} -result {bob@x.com bob2@x.com FN}

test tkuvcard-2.3 {removeCard} -constraints vcard -body {
    catch {destroy .v}; set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    ::tkutils::tkuvcard::removeCard $w 1
    ::tkutils::tkuvcard::count $w
} -result 1

test tkuvcard-2.4 {toText round-trips edits} -constraints vcard -body {
    catch {destroy .v}; set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w $vcf
    ::tkutils::tkuvcard::addCard $w "Zoe"
    llength [::tclutils::tuvcard::parse [::tkutils::tkuvcard::toText $w]]
} -result 3

test tkuvcard-photo-1 {inline PNG photo is displayed as an image} -constraints vcard -setup {
    set tdir [::tcltest::makeDirectory pf]; set tf [file join $tdir s.png]
    set g [image create photo -width 40 -height 30]; $g put blue -to 0 0 40 30
    $g write $tf -format png; image delete $g
    set ch [open $tf rb]; set png [read $ch]; close $ch
} -body {
    catch {destroy .v}
    ::tkutils::tkuvcard::widget .v
    set card [::tclutils::tuvcard::setPhoto [::tclutils::tuvcard::addProperty {} FN Jane] image/png $png]
    ::tkutils::tkuvcard::loadText .v [::tclutils::tuvcard::toVcf $card]
    set tv .v.tv
    $tv selection set [lindex [$tv children {}] 0]
    ::tkutils::tkuvcard::_onSelect .v
    set r [list [expr {$::tkutils::tkuvcard::state(.v,photoimg) ne ""}]                 [expr {[.v.photo cget -image] ne ""}]]
    destroy .v; set r
} -cleanup { ::tcltest::removeDirectory pf } -result {1 1}

test tkuvcard-photo-2 {URI photo is shown as text, no image} -constraints vcard -body {
    catch {destroy .v}
    ::tkutils::tkuvcard::widget .v
    set card [::tclutils::tuvcard::setPhotoUri [::tclutils::tuvcard::addProperty {} FN Jane] https://x/me.png]
    ::tkutils::tkuvcard::loadText .v [::tclutils::tuvcard::toVcf $card]
    set tv .v.tv
    $tv selection set [lindex [$tv children {}] 0]
    ::tkutils::tkuvcard::_onSelect .v
    set r [list [expr {[.v.photo cget -image] eq ""}]                 [string match *URI* [.v.photo cget -text]]]
    destroy .v; set r
} -result {1 1}

test tkuvcard-photo-3 {card without photo shows placeholder} -constraints vcard -body {
    catch {destroy .v}
    ::tkutils::tkuvcard::widget .v
    ::tkutils::tkuvcard::loadText .v "BEGIN:VCARD\r\nFN:Jane\r\nEND:VCARD\r\n"
    set tv .v.tv
    $tv selection set [lindex [$tv children {}] 0]
    ::tkutils::tkuvcard::_onSelect .v
    set r [.v.photo cget -text]
    destroy .v; set r
} -result {(no photo)}

proc _bytes {f} { set ch [open $f rb]; set b [read $ch]; close $ch; return $b }
test tkuvcard-3.1 {save: CRLF once, UTF-8; loadFile reads it back} -constraints vcard -setup {
    ::set f [makeFile {} tkuvcard-3.1.vcf]
    ::set enc [encoding system]
} -body {
    catch {destroy .v}; set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:J\u00f6rg M\u00fcller\r\nTEL;TYPE=CELL;PREF=1:123\r\nEND:VCARD\r\n"
    encoding system iso8859-1
    ::tkutils::tkuvcard::save $w $f
    ::set b [_bytes $f]
    catch {destroy .v2}; set w2 [::tkutils::tkuvcard::widget .v2]
    ::tkutils::tkuvcard::loadFile $w2 $f
    encoding system $enc
    list [string first "\r\r\n" $b] \
         [expr {[string first [encoding convertto utf-8 "J\u00f6rg"] $b] >= 0}] \
         [::tclutils::tuvcard::property [lindex [::tkutils::tkuvcard::cards $w2] 0] FN]
} -cleanup {
    encoding system $enc
    removeFile tkuvcard-3.1.vcf
    catch {destroy .v .v2}
} -result "-1 1 {J\u00f6rg M\u00fcller}"

test tkuvcard-3.2 {setProperty keeps PREF and other parameters; TYPE lists} -constraints vcard -body {
    catch {destroy .v}; set w [::tkutils::tkuvcard::widget .v]
    ::tkutils::tkuvcard::loadText $w "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:A\r\nTEL;TYPE=CELL;PREF=1:123\r\nEND:VCARD\r\n"
    ::set p {}
    ::tkutils::tkuvcard::setProperty $w 0 2 TEL 456 CELL
    lappend p [dict get [lindex [lindex [::tkutils::tkuvcard::cards $w] 0] 2] params]
    ::tkutils::tkuvcard::setProperty $w 0 2 TEL 456 {WORK, VOICE}
    lappend p [dict get [lindex [lindex [::tkutils::tkuvcard::cards $w] 0] 2] params]
    ::tkutils::tkuvcard::setProperty $w 0 2 TEL 789 {}
    lappend p [dict get [lindex [lindex [::tkutils::tkuvcard::cards $w] 0] 2] params]
    lappend p [dict get [lindex [lindex [::tkutils::tkuvcard::cards $w] 0] 2] value]
} -cleanup { catch {destroy .v} } -result {{TYPE CELL PREF 1} {PREF 1 TYPE WORK TYPE VOICE} {PREF 1} 789}

test tkuvcard-9.1 {a failed save leaves the old file, no temp file, no channel} -constraints {vcard} -setup {
    set f [makeFile PRECIOUS tkuvcard-9.1.vcf]
    catch {destroy .vcw}; set w [::tkutils::tkuvcard::widget .vcw]
    ::tkutils::tkuvcard::loadText $w "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:A\r\nEND:VCARD\r\n"
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tkutils::tkuvcard::save $w $f}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tkuvcard-9.1.vcf
} -result {1 PRECIOUS 0 0}

cleanupTests
