package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set haveTk 1
if {[catch {package require Tk 8.6-}]} { set haveTk 0 }
set haveTdom 1
if {[catch {package require tdom}]} { set haveTdom 0 }
testConstraint tkxml [expr {$haveTk && $haveTdom}]
set here [file dirname [file normalize [info script]]]
set tmDir [file normalize [file join $here .. lib tm]]
tcl::tm::path add $tmDir
# locate the tclutils dependency for in-tree/dev use
# (installed systems already have tclutils on the module path)
if {[info exists ::env(TCLUTILS_TM)]} {
    tcl::tm::path add $::env(TCLUTILS_TM)
} else {
    set _tkuRoot [file dirname [file dirname $tmDir]]
    foreach _c [lsort -decreasing [glob -nocomplain [file join [file dirname $_tkuRoot] tclutils*/lib/tm]]] {
        tcl::tm::path add $_c
        break
    }
}
if {$haveTk && $haveTdom} { package require tkutils::tkxml }

set sample {<root a="1"><child>hi</child><child id="x"><leaf/></child></root>}

test tkxml-1.1 {root name} -constraints tkxml -body {
    catch {destroy .x}
    set w [::tkutils::tkxml::widget .x]
    ::tkutils::tkxml::setXml $w $sample
} -result root

test tkxml-1.2 {root has two element children} -constraints tkxml -body {
    catch {destroy .x}
    set w [::tkutils::tkxml::widget .x]
    ::tkutils::tkxml::setXml $w $sample
    set root [lindex [$w.tv children {}] 0]
    llength [$w.tv children $root]
} -result 2

test tkxml-1.3 {first child shows its text node} -constraints tkxml -body {
    catch {destroy .x}
    set w [::tkutils::tkxml::widget .x]
    ::tkutils::tkxml::setXml $w $sample
    set root [lindex [$w.tv children {}] 0]
    set c1 [lindex [$w.tv children $root] 0]
    set txt [lindex [$w.tv children $c1] 0]
    return "[$w.tv item $txt -text]=[$w.tv item $txt -values]"
} -result {#text=hi}

cleanupTests
